  $DB\TourneSafeMode\shell\3cmd\command | @ = sz:$PS "Start-Process cmd.exe -Verb RunAs -ArgumentList '/c','bcdedit /set {current} safeboot minimal && bcdedit /set {current} safebootalternateshell yes && shutdown /r /t 0'"
  $DB\TourneSafeMode\shell\4normal | MUIVerb = sz:Restart normally
  $DB\TourneSafeMode\shell\4normal\command | @ = sz:$PS "Start-Process cmd.exe -Verb RunAs -ArgumentList '/c','bcdedit /deletevalue {current} safeboot & bcdedit /deletevalue {current} safebootalternateshell & shutdown /r /t 0'"
