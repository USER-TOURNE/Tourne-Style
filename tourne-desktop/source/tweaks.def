  key = enabled
default: disabled

toggle bashHere "Folders: Linux shell here"
| Opens WSL in the folder, when it's installed.
on:
  $CLS\Directory\shell\TourneWsl | MUIVerb = sz:Open Linux shell here
  $CLS\Directory\shell\TourneWsl | Icon = sz:wsl.exe
  $CLS\Directory\shell\TourneWsl\command | @ = sz:wsl.exe --cd "%V"
  $CLS\Directory\Background\shell\TourneWsl | MUIVerb = sz:Open Linux shell here
  $CLS\Directory\Background\shell\TourneWsl | Icon = sz:wsl.exe
  $CLS\Directory\Background\shell\TourneWsl\command | @ = sz:wsl.exe --cd "%V"
off:
  $CLS\Directory\shell\TourneWsl | -
  $CLS\Directory\Background\shell\TourneWsl | -

toggle caseSensitivity "Folders: Case sensitivity"
| Makes a folder treat File.txt and file.txt as two files, or not, for Linux
| tools.
on:
  $CLS\Directory\shell\TourneCase | MUIVerb = sz:Case sensitivity
  $CLS\Directory\shell\TourneCase | SubCommands = sz:
  $CLS\Directory\shell\TourneCase\shell\1on | MUIVerb = sz:Turn on
  $CLS\Directory\shell\TourneCase\shell\1on | HasLUAShield = sz:
  $CLS\Directory\shell\TourneCase\shell\1on\command | @ = sz:$PS "Start-Process fsutil.exe -Verb RunAs -ArgumentList 'file','setCaseSensitiveInfo','\"%1\"','enable'"
  $CLS\Directory\shell\TourneCase\shell\2off | MUIVerb = sz:Turn off
  $CLS\Directory\shell\TourneCase\shell\2off | HasLUAShield = sz:
  $CLS\Directory\shell\TourneCase\shell\2off\command | @ = sz:$PS "Start-Process fsutil.exe -Verb RunAs -ArgumentList 'file','setCaseSensitiveInfo','\"%1\"','disable'"
  $CLS\Directory\shell\TourneCase\shell\3query | MUIVerb = sz:Show state
  $CLS\Directory\shell\TourneCase\shell\3query\command | @ = sz:cmd.exe /k fsutil.exe file queryCaseSensitiveInfo "%1"
off:
  $CLS\Directory\shell\TourneCase | -

toggle attributes "Files and folders: Attributes"
| Hide, show, make read-only and the like, without opening Properties.
on:
  $CLS\AllFilesystemObjects\shell\TourneAttributes | MUIVerb = sz:Attributes
  $CLS\AllFilesystemObjects\shell\TourneAttributes | SubCommands = sz:
  $CLS\AllFilesystemObjects\shell\TourneAttributes\shell\1hide | MUIVerb = sz:Hide
  $CLS\AllFilesystemObjects\shell\TourneAttributes\shell\1hide\command | @ = sz:attrib.exe +h "%1"
  $CLS\AllFilesystemObjects\shell\TourneAttributes\shell\2show | MUIVerb = sz:Unhide
  $CLS\AllFilesystemObjects\shell\TourneAttributes\shell\2show\command | @ = sz:attrib.exe -h "%1"
  $CLS\AllFilesystemObjects\shell\TourneAttributes\shell\3ro | MUIVerb = sz:Make read-only
  $CLS\AllFilesystemObjects\shell\TourneAttributes\shell\3ro\command | @ = sz:attrib.exe +r "%1"
  $CLS\AllFilesystemObjects\shell\TourneAttributes\shell\4rw | MUIVerb = sz:Make writable
  $CLS\AllFilesystemObjects\shell\TourneAttributes\shell\4rw\command | @ = sz:attrib.exe -r "%1"
  $CLS\AllFilesystemObjects\shell\TourneAttributes\shell\5sys | MUIVerb = sz:Mark as system
  $CLS\AllFilesystemObjects\shell\TourneAttributes\shell\5sys\command | @ = sz:attrib.exe +s "%1"
  $CLS\AllFilesystemObjects\shell\TourneAttributes\shell\6nosys | MUIVerb = sz:Unmark as system
  $CLS\AllFilesystemObjects\shell\TourneAttributes\shell\6nosys\command | @ = sz:attrib.exe -s "%1"
off:
  $CLS\AllFilesystemObjects\shell\TourneAttributes | -

toggle viewOwner "Files and folders: Show owner"
| Shows which account owns it.
on:
  $CLS\AllFilesystemObjects\shell\TourneViewOwner | MUIVerb = sz:Show owner
  $CLS\AllFilesystemObjects\shell\TourneViewOwner\command | @ = sz:powershell.exe -NoProfile -NoExit -Command "(Get-Acl -LiteralPath '%1').Owner"
off:
  $CLS\AllFilesystemObjects\shell\TourneViewOwner | -

toggle takeOwnership "Files and folders: Take ownership"
| Makes your account the owner, so you can change or delete files Windows
| protects.
on:
  $CLS\*\shell\TourneTakeOwn | MUIVerb = sz:Take ownership
  $CLS\*\shell\TourneTakeOwn | HasLUAShield = sz:
  $CLS\*\shell\TourneTakeOwn\command | @ = sz:$PS "Start-Process cmd.exe -Verb RunAs -ArgumentList '/c','takeown /f \"%1\" && icacls \"%1\" /grant *S-1-5-32-544:F'"
  $CLS\Directory\shell\TourneTakeOwn | MUIVerb = sz:Take ownership
  $CLS\Directory\shell\TourneTakeOwn | HasLUAShield = sz:
  $CLS\Directory\shell\TourneTakeOwn\command | @ = sz:$PS "Start-Process cmd.exe -Verb RunAs -ArgumentList '/c','takeown /f \"%1\" /r /d y && icacls \"%1\" /grant *S-1-5-32-544:F /t'"
off:
  $CLS\*\shell\TourneTakeOwn | -
  $CLS\Directory\shell\TourneTakeOwn | -

toggle changeOwner "Files and folders: Change owner"
| Hands ownership to Administrators, Everyone, SYSTEM, TrustedInstaller or
| you.
on:
  $CLS\AllFilesystemObjects\shell\TourneOwner | MUIVerb = sz:Change owner
  $CLS\AllFilesystemObjects\shell\TourneOwner | SubCommands = sz:
  $CLS\AllFilesystemObjects\shell\TourneOwner | HasLUAShield = sz:
  $CLS\AllFilesystemObjects\shell\TourneOwner\shell\1admins | MUIVerb = sz:Administrators
  $CLS\AllFilesystemObjects\shell\TourneOwner\shell\1admins\command | @ = sz:$PS "Start-Process icacls.exe -Verb RunAs -ArgumentList '\"%1\"','/setowner','*S-1-5-32-544','/T','/C'"
  $CLS\AllFilesystemObjects\shell\TourneOwner\shell\2everyone | MUIVerb = sz:Everyone
  $CLS\AllFilesystemObjects\shell\TourneOwner\shell\2everyone\command | @ = sz:$PS "Start-Process icacls.exe -Verb RunAs -ArgumentList '\"%1\"','/setowner','*S-1-1-0','/T','/C'"
  $CLS\AllFilesystemObjects\shell\TourneOwner\shell\3system | MUIVerb = sz:SYSTEM
  $CLS\AllFilesystemObjects\shell\TourneOwner\shell\3system\command | @ = sz:$PS "Start-Process icacls.exe -Verb RunAs -ArgumentList '\"%1\"','/setowner','*S-1-5-18','/T','/C'"
  $CLS\AllFilesystemObjects\shell\TourneOwner\shell\4ti | MUIVerb = sz:TrustedInstaller
  $CLS\AllFilesystemObjects\shell\TourneOwner\shell\4ti\command | @ = sz:$PS "Start-Process icacls.exe -Verb RunAs -ArgumentList '\"%1\"','/setowner','\"NT SERVICE\TrustedInstaller\"','/T','/C'"
  $CLS\AllFilesystemObjects\shell\TourneOwner\shell\5me | MUIVerb = sz:Me
  $CLS\AllFilesystemObjects\shell\TourneOwner\shell\5me\command | @ = sz:$PS "Start-Process takeown.exe -Verb RunAs -ArgumentList '/F','\"%1\"','/R','/D','Y'"
off:
  $CLS\AllFilesystemObjects\shell\TourneOwner | -

toggle resetPermissions "Files and folders: Reset permissions"
| Puts back the permissions it would get from its folder.
on:
  $CLS\AllFilesystemObjects\shell\TourneResetAcl | MUIVerb = sz:Reset permissions
  $CLS\AllFilesystemObjects\shell\TourneResetAcl | HasLUAShield = sz:
  $CLS\AllFilesystemObjects\shell\TourneResetAcl\command | @ = sz:$PS "Start-Process icacls.exe -Verb RunAs -ArgumentList '\"%1\"','/reset','/T','/C','/Q'"
off:
  $CLS\AllFilesystemObjects\shell\TourneResetAcl | -

toggle inheritanceMenu "Files and folders: Inherited permissions"
| Turns taking permissions from the folder above on or off.
on:
  $CLS\AllFilesystemObjects\shell\TourneInherit | MUIVerb = sz:Inherited permissions
  $CLS\AllFilesystemObjects\shell\TourneInherit | SubCommands = sz:
  $CLS\AllFilesystemObjects\shell\TourneInherit | HasLUAShield = sz:
  $CLS\AllFilesystemObjects\shell\TourneInherit\shell\1on | MUIVerb = sz:Turn on
  $CLS\AllFilesystemObjects\shell\TourneInherit\shell\1on\command | @ = sz:$PS "Start-Process icacls.exe -Verb RunAs -ArgumentList '\"%1\"','/inheritance:e'"
  $CLS\AllFilesystemObjects\shell\TourneInherit\shell\2copy | MUIVerb = sz:Turn off, keep a copy
  $CLS\AllFilesystemObjects\shell\TourneInherit\shell\2copy\command | @ = sz:$PS "Start-Process icacls.exe -Verb RunAs -ArgumentList '\"%1\"','/inheritance:d'"
  $CLS\AllFilesystemObjects\shell\TourneInherit\shell\3remove | MUIVerb = sz:Turn off and remove
  $CLS\AllFilesystemObjects\shell\TourneInherit\shell\3remove\command | @ = sz:$PS "Start-Process icacls.exe -Verb RunAs -ArgumentList '\"%1\"','/inheritance:r'"
off:
  $CLS\AllFilesystemObjects\shell\TourneInherit | -

toggle encryptMenu "Files and folders: Encrypt and Decrypt"
| Uses the Encrypting File System, on editions of Windows that have it.
on:
  $ADV | EncryptionContextMenu = dword:1
off:
  $ADV | EncryptionContextMenu -

toggle hashMenu "Files: Hash"
| Shows a file's SHA256, SHA1 or MD5 checksum, for checking a download.
on:
  $CLS\*\shell\TourneHash | MUIVerb = sz:Hash
  $CLS\*\shell\TourneHash | SubCommands = sz:
  $CLS\*\shell\TourneHash\shell\1sha256 | MUIVerb = sz:SHA256
  $CLS\*\shell\TourneHash\shell\1sha256\command | @ = sz:powershell.exe -NoProfile -NoExit -Command "Get-FileHash -LiteralPath '%1' -Algorithm SHA256 | Format-List"
  $CLS\*\shell\TourneHash\shell\2sha1 | MUIVerb = sz:SHA1
  $CLS\*\shell\TourneHash\shell\2sha1\command | @ = sz:powershell.exe -NoProfile -NoExit -Command "Get-FileHash -LiteralPath '%1' -Algorithm SHA1 | Format-List"
  $CLS\*\shell\TourneHash\shell\3sha384 | MUIVerb = sz:SHA384
  $CLS\*\shell\TourneHash\shell\3sha384\command | @ = sz:powershell.exe -NoProfile -NoExit -Command "Get-FileHash -LiteralPath '%1' -Algorithm SHA384 | Format-List"
  $CLS\*\shell\TourneHash\shell\4sha512 | MUIVerb = sz:SHA512
  $CLS\*\shell\TourneHash\shell\4sha512\command | @ = sz:powershell.exe -NoProfile -NoExit -Command "Get-FileHash -LiteralPath '%1' -Algorithm SHA512 | Format-List"
  $CLS\*\shell\TourneHash\shell\5md5 | MUIVerb = sz:MD5
  $CLS\*\shell\TourneHash\shell\5md5\command | @ = sz:powershell.exe -NoProfile -NoExit -Command "Get-FileHash -LiteralPath '%1' -Algorithm MD5 | Format-List"
  $CLS\*\shell\TourneHash\shell\6all | MUIVerb = sz:All of them
  $CLS\*\shell\TourneHash\shell\6all\command | @ = sz:powershell.exe -NoProfile -NoExit -Command "'SHA256','SHA1','SHA384','SHA512','MD5' | ForEach-Object { Get-FileHash -LiteralPath '%1' -Algorithm $_ } | Format-List"
off:
  $CLS\*\shell\TourneHash | -

toggle unblockMenu "Files: Unblock"
| Removes the "came from the internet" mark that makes Windows warn before
| opening it.
on:
  $CLS\*\shell\TourneUnblock | MUIVerb = sz:Unblock
  $CLS\*\shell\TourneUnblock\command | @ = sz:$PS "Unblock-File -LiteralPath '%1'"
  $CLS\Directory\shell\TourneUnblock | MUIVerb = sz:Unblock everything inside
  $CLS\Directory\shell\TourneUnblock\command | @ = sz:$PS "Get-ChildItem -LiteralPath '%1' -Recurse -File | Unblock-File"
off:
  $CLS\*\shell\TourneUnblock | -
  $CLS\Directory\shell\TourneUnblock | -

toggle runWithPriority "Programs: Run with priority"
| Starts a program at a CPU priority you pick.
on:
  $CLS\exefile\shell\TournePriority | MUIVerb = sz:Run with priority
  $CLS\exefile\shell\TournePriority | SubCommands = sz:
  $CLS\exefile\shell\TournePriority\shell\1realtime | MUIVerb = sz:Realtime
  $CLS\exefile\shell\TournePriority\shell\1realtime\command | @ = sz:cmd.exe /c start "" /realtime "%1"
  $CLS\exefile\shell\TournePriority\shell\2high | MUIVerb = sz:High
  $CLS\exefile\shell\TournePriority\shell\2high\command | @ = sz:cmd.exe /c start "" /high "%1"
  $CLS\exefile\shell\TournePriority\shell\3above | MUIVerb = sz:Above normal
  $CLS\exefile\shell\TournePriority\shell\3above\command | @ = sz:cmd.exe /c start "" /abovenormal "%1"
  $CLS\exefile\shell\TournePriority\shell\4normal | MUIVerb = sz:Normal
  $CLS\exefile\shell\TournePriority\shell\4normal\command | @ = sz:cmd.exe /c start "" /normal "%1"
  $CLS\exefile\shell\TournePriority\shell\5below | MUIVerb = sz:Below normal
  $CLS\exefile\shell\TournePriority\shell\5below\command | @ = sz:cmd.exe /c start "" /belownormal "%1"
  $CLS\exefile\shell\TournePriority\shell\6low | MUIVerb = sz:Low
  $CLS\exefile\shell\TournePriority\shell\6low\command | @ = sz:cmd.exe /c start "" /low "%1"
off:
  $CLS\exefile\shell\TournePriority | -

toggle runAsPs1 "PowerShell scripts: Run as administrator"
on:
  $CLS\SystemFileAssociations\.ps1\Shell\runas | HasLUAShield = sz:
  $CLS\SystemFileAssociations\.ps1\Shell\runas | MUIVerb = sz:Run as administrator
  $CLS\SystemFileAssociations\.ps1\Shell\runas\command | @ = sz:powershell.exe -NoProfile -ExecutionPolicy Bypass -NoExit -File "%1"
off:
  $CLS\SystemFileAssociations\.ps1\Shell\runas | -

