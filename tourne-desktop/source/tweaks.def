  $CLS\Directory\Background\shell\TourneTerminalAdmin | HasLUAShield = sz:
  $CLS\Directory\Background\shell\TourneTerminalAdmin\command | @ = sz:$PS "Start-Process wt.exe -Verb RunAs -ArgumentList '-d','\"%V\"'"
option shift "On, with Shift held":
  $CLS\Directory\shell\TourneTerminalAdmin | MUIVerb = sz:Terminal here (administrator)
  $CLS\Directory\shell\TourneTerminalAdmin | Extended = sz:
  $CLS\Directory\shell\TourneTerminalAdmin | HasLUAShield = sz:
  $CLS\Directory\shell\TourneTerminalAdmin\command | @ = sz:$PS "Start-Process wt.exe -Verb RunAs -ArgumentList '-d','\"%V\"'"
  $CLS\Directory\Background\shell\TourneTerminalAdmin | MUIVerb = sz:Terminal here (administrator)
