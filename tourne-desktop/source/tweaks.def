# Tourne'Suite Tweaks: the options from Winaero Tweaker 1.65 that are a
# setting (pages that only run a tool, create a shortcut or link to a
# download are left out), written from the documented Windows settings behind
# each one. Options Windows itself offers (in Settings, Folder Options,
# Windows Security or Edge's own settings) are left out too; each group's
# description says where to find them. Build-TourneSuiteRedirect.ps1 turns
# this file into the Tweaks part: the settings schema, with defaults read
# from this PC's registry, and the table the part applies.
#
# Groups are in the order the settings page shows them, most used first.
# Every group but general gets a "Use these tweaks" switch at its top
# (setting <group>.use, made by Build-Tweaks.ps1), off to begin with: the
# part applies nothing in a group until it's on.
#
# Syntax
#   define NAME value          $NAME in any later line becomes value
#   group id "Title"           following tweaks are settings "id.<tweak>"
#   toggle id "Title" [after=explorer|signout|restart] [default=true|false]
#   number id "Title" default=N [min=N] [max=N] [after=...]
#   text id "Title" [default="..."] [after=...] [keep-empty] [private]
#   choice id "Title" default=key [after=...]
#   | text                     description line (joined)
#   uses: group.id ...         other settings this tweak's ops read as {@group.id}
#   on: / off:                 toggle ops
#   set: / unset:              number/text ops; unset: runs when the value is
#                              the Windows default (or empty for text)
#   read: KEY | name [as=twips|drives|logfont|px]  where the build reads the
#                              current value (number/text)
#   detect:                    ops that must all match for "on"; several
#                              detect: blocks mean any of them (toggle)
#   option key "Label":        choice option, its ops follow
#
# Ops (indented under a block)
#   KEY | -                    delete the key and everything under it
#   KEY | +                    create the key
#   KEY | name = type:value    set a value; name @ is the default value;
#                              types: sz expand dword qword multi (; between)
#   KEY | name -               delete a value
#   run COMMAND                run as the user, hidden
#   admin COMMAND              run elevated (with the machine-wide changes)
#   spi ui|pv CODE VALUE       SystemParametersInfo, saved and broadcast
#   metric FIELD VALUE         window metric, applied live in one call
#   font FIELD VALUE           window metric font, "Face, size, bold, italic"
#   notify AREA                WM_SETTINGCHANGE broadcast for AREA
#   style PATH                 switch the visual style live
# In values, {} is the setting's value, {twips} is -15 times it, {drives} is
# the NoDrives mask for a list of letters, {@group.id} is another setting.
# HKCU keys are written directly and live; HKLM and HKU keys are collected
# into one elevated step, which asks for admin once per save.

define ADV $CUEXP\Advanced
define CUEXP HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer
define LMEXP HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer
define CDM HKCU\Software\Microsoft\Windows\CurrentVersion\ContentDeliveryManager
define DESK HKCU\Control Panel\Desktop
define PSYS HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System
define LMPEXP HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer
define CUPEXP HKCU\Software\Microsoft\Windows\CurrentVersion\Policies\Explorer
define WPOL HKLM\SOFTWARE\Policies\Microsoft\Windows
define CUWPOL HKCU\Software\Policies\Microsoft\Windows
define EDGE HKLM\SOFTWARE\Policies\Microsoft\Edge
define CLS HKCU\Software\Classes
define LMCLS HKLM\SOFTWARE\Classes
define DB HKCU\Software\Classes\DesktopBackground\Shell
define LMDB HKLM\SOFTWARE\Classes\DesktopBackground\Shell
define PERS HKCU\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize
define WM HKCU\Control Panel\Desktop\WindowMetrics
define BLOCK HKCU\Software\Microsoft\Windows\CurrentVersion\Shell Extensions\Blocked
define LMBLOCK HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Shell Extensions\Blocked
define THISPC $CLS\CLSID\{20D04FE0-3AEA-1069-A2D8-08002B30309D}\shell
define LMNS $LMEXP\MyComputer\NameSpace
define WOWNS HKLM\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Explorer\MyComputer\NameSpace
define PS powershell.exe -NoProfile -WindowStyle Hidden -Command

##################################################### how tweaks are applied
group general "How tweaks are applied"
| Every group below starts switched off and changes nothing. To use one,
| switch on "Use these tweaks" at its top, then change what you want in it
| and Save. Switching a group on applies nothing by itself: the suite only
| notes how each tweak is set. Settings that Windows already offers in
| Settings, Folder Options or Edge aren't repeated here.

toggle restartExplorer "Restart Explorer when a change needs it" default=false
| Some changes only show once Explorer (the taskbar, desktop and File
| Explorer) restarts. On: the suite restarts it for you after a Save that
| needs it. Off: they show the next time you sign in.

toggle liveFontSwap "Show a new system font straight away" default=false
| Goes with Fonts and sizes > System font. Programs already running switch
| to the new font at once, instead of after you sign out. Only programs that
| draw text with GDI follow; newer ones still need a sign-out.

############################################### privacy, ads and suggestions
group privacy "Privacy, ads and suggestions"
| Windows' own switches for ads and suggestions are in Settings > Privacy &
| security > General, Settings > Personalization > Start and Lock screen,
| and Settings > System > Notifications > Additional settings. These are the
| ones Settings doesn't have.

toggle adsSilentApps "Don't install suggested apps without asking"
| Stops Windows quietly installing the apps it suggests, such as games
| pinned to Start after setup.
on:
  $CDM | SilentInstalledAppsEnabled = dword:0
  $CDM | PreInstalledAppsEnabled = dword:0
  $CDM | OemPreInstalledAppsEnabled = dword:0
off:
  $CDM | SilentInstalledAppsEnabled = dword:1
  $CDM | PreInstalledAppsEnabled = dword:1
  $CDM | OemPreInstalledAppsEnabled = dword:1

toggle adsConsumer "No suggested apps and content (policy)" after=signout
| The policy behind the one above, which also stops Windows promoting apps
| and content. Windows only follows it on the Enterprise and Education
| editions.
on:
  $WPOL\CloudContent | DisableWindowsConsumerFeatures = dword:1
off:
  $WPOL\CloudContent | DisableWindowsConsumerFeatures -

toggle copilot "Turn off Copilot" after=signout
| Turns Copilot off for this PC and removes its taskbar button. (Settings
| can only hide the button.)
on:
  $CUWPOL\WindowsCopilot | TurnOffWindowsCopilot = dword:1
  $WPOL\WindowsCopilot | TurnOffWindowsCopilot = dword:1
  $ADV | ShowCopilotButton = dword:0
off:
  $CUWPOL\WindowsCopilot | TurnOffWindowsCopilot -
  $WPOL\WindowsCopilot | TurnOffWindowsCopilot -
  $ADV | ShowCopilotButton -
detect:
  $CUWPOL\WindowsCopilot | TurnOffWindowsCopilot = dword:1

toggle noWebSearch "No web results in Windows search"
| Search on the taskbar and in Start only looks on this PC; Bing results
| leave.
on:
  HKCU\Software\Microsoft\Windows\CurrentVersion\Search | BingSearchEnabled = dword:0
  HKCU\Software\Microsoft\Windows\CurrentVersion\Search | CortanaConsent = dword:0
off:
  HKCU\Software\Microsoft\Windows\CurrentVersion\Search | BingSearchEnabled -
  HKCU\Software\Microsoft\Windows\CurrentVersion\Search | CortanaConsent -
detect:
  HKCU\Software\Microsoft\Windows\CurrentVersion\Search | BingSearchEnabled = dword:0

toggle noTelemetry "Send Microsoft as little diagnostic data as allowed" after=restart
| Lowers diagnostic data to the minimum this edition of Windows allows.
| Settings can only turn off the optional part.
on:
  $WPOL\DataCollection | AllowTelemetry = dword:0
off:
  $WPOL\DataCollection | AllowTelemetry -

toggle noErrorReporting "Turn off Windows Error Reporting"
| Crashes are no longer reported to Microsoft, and the "Looking for a
| solution" dialog stops.
on:
  HKLM\SOFTWARE\Microsoft\Windows\Windows Error Reporting | Disabled = dword:1
off:
  HKLM\SOFTWARE\Microsoft\Windows\Windows Error Reporting | Disabled -

toggle backgroundApps "Stop all Store apps running in the background" after=signout
| One switch for every Store app at once. Settings only offers this per app.
on:
  HKCU\Software\Microsoft\Windows\CurrentVersion\BackgroundAccessApplications | GlobalUserDisabled = dword:1
  HKCU\Software\Microsoft\Windows\CurrentVersion\Search | BackgroundAppGlobalToggle = dword:0
  $WPOL\AppPrivacy | LetAppsRunInBackground = dword:2
off:
  HKCU\Software\Microsoft\Windows\CurrentVersion\BackgroundAccessApplications | GlobalUserDisabled -
  HKCU\Software\Microsoft\Windows\CurrentVersion\Search | BackgroundAppGlobalToggle -
  $WPOL\AppPrivacy | LetAppsRunInBackground -
detect:
  $WPOL\AppPrivacy | LetAppsRunInBackground = dword:2
detect:
  HKCU\Software\Microsoft\Windows\CurrentVersion\BackgroundAccessApplications | GlobalUserDisabled = dword:1

toggle noStoreLookup "No \"Look for an app in the Store\" when opening a file"
| Opening a file no program handles goes straight to the list of programs on
| this PC.
on:
  $WPOL\Explorer | NoUseStoreOpenWith = dword:1
off:
  $WPOL\Explorer | NoUseStoreOpenWith -

toggle noNewAppAlert "No \"You have new apps that can open this type of file\""
| Stops the notice that pops up after installing a program that can open a
| file type you already use.
on:
  $WPOL\Explorer | NoNewAppAlert = dword:1
off:
  $WPOL\Explorer | NoNewAppAlert -

################################################# start, taskbar and desktop
group start "Start, taskbar and desktop"
| For Windows' own Start menu, taskbar and desktop. The suite's Taskbar and
| Start menu parts have their own settings.

toggle hideRecommended "Hide Recommended in Start completely" after=restart
| Removes the whole Recommended section. Windows only allows it on education
| PCs, so this marks the PC as one; Windows Spotlight may stop working while
| it's on. To just empty the section, use Settings > Personalization > Start
| instead.
on:
  $WPOL\Explorer | HideRecommendedSection = dword:1
  HKLM\SOFTWARE\Microsoft\PolicyManager\current\device\Start | HideRecommendedSection = dword:1
  HKLM\SOFTWARE\Microsoft\PolicyManager\current\device\Education | IsEducationEnvironment = dword:1
off:
  $WPOL\Explorer | HideRecommendedSection -
  HKLM\SOFTWARE\Microsoft\PolicyManager\current\device\Start | HideRecommendedSection -
  HKLM\SOFTWARE\Microsoft\PolicyManager\current\device\Education | IsEducationEnvironment -
detect:
  $WPOL\Explorer | HideRecommendedSection = dword:1

choice colorizeTaskbar "Accent colour on the taskbar only"
| Settings can paint the accent colour on Start and the taskbar together.
| "Taskbar only" uses a value Windows 11 doesn't document; if it shows no
| change, pick another option.
option disabled "Nowhere":
  $PERS | ColorPrevalence = dword:0
  notify ImmersiveColorSet
option both "Taskbar and Start":
  $PERS | ColorPrevalence = dword:1
  notify ImmersiveColorSet
option taskbar "Taskbar only":
  $PERS | ColorPrevalence = dword:2
  notify ImmersiveColorSet

toggle notificationsStayOpen "Notification Center stays open"
| Clicking away no longer closes it; click the clock again to close it, as
| in Windows 10's Action Center.
on:
  HKCU\Software\Microsoft\Windows\CurrentVersion\ImmersiveShell\Launcher | DisableLightDismiss = dword:1
off:
  HKCU\Software\Microsoft\Windows\CurrentVersion\ImmersiveShell\Launcher | DisableLightDismiss -

toggle spotlightIcon "Hide the Windows Spotlight desktop icon" after=explorer
| Removes the "Learn about this picture" icon Windows Spotlight puts on the
| desktop.
on:
  $CUEXP\HideDesktopIcons\NewStartPanel | {2cc5ca98-6485-489a-920e-b3e88a6ccce3} = dword:1
off:
  $CUEXP\HideDesktopIcons\NewStartPanel | {2cc5ca98-6485-489a-920e-b3e88a6ccce3} -

toggle stickers "Desktop stickers" after=restart
| Adds "Add or edit stickers" to the desktop's right-click menu, for
| stickers on top of the wallpaper.
on:
  HKLM\SOFTWARE\Microsoft\PolicyManager\current\device\Stickers | EnableStickers = dword:1
off:
  HKLM\SOFTWARE\Microsoft\PolicyManager\current\device\Stickers | EnableStickers -

toggle desktopVersion "Show the Windows version on the desktop" after=signout
| Writes the Windows edition and build number in the bottom corner of the
| desktop.
on:
  $DESK | PaintDesktopVersion = dword:1
off:
  $DESK | PaintDesktopVersion = dword:0

number wallpaperQuality "JPEG wallpaper quality (%)" default=85 min=60 max=100
| Windows re-encodes JPEG wallpapers at 85%. 100 keeps them sharp. Applies
| to the next wallpaper you set.
set:
  $DESK | JPEGImportQuality = dword:{}
unset:
  $DESK | JPEGImportQuality -
read: $DESK | JPEGImportQuality

choice shutdownDefault "Alt + F4 on the desktop selects" after=explorer
| What the Shut Down Windows box has picked when you press Alt + F4 on the
| desktop.
option default "Windows default":
  $ADV | Start_PowerButtonAction -
option shutdown "Shut down":
  $ADV | Start_PowerButtonAction = dword:2
option restart "Restart":
  $ADV | Start_PowerButtonAction = dword:4
option signout "Sign out":
  $ADV | Start_PowerButtonAction = dword:1
option sleep "Sleep":
  $ADV | Start_PowerButtonAction = dword:16
option hibernate "Hibernate":
  $ADV | Start_PowerButtonAction = dword:64
option switch "Switch user":
  $ADV | Start_PowerButtonAction = dword:256
detect-choice: $ADV | Start_PowerButtonAction
  2 = shutdown
  4 = restart
  1 = signout
  16 = sleep
  64 = hibernate
  256 = switch
default: default

toggle runAsUserStart "\"Run as different user\" in Start" after=explorer
| Adds it to the right-click menu of programs in Start, for running one with
| another account.
on:
  $CUWPOL\Explorer | ShowRunAsDifferentUserInStart = dword:1
off:
  $CUWPOL\Explorer | ShowRunAsDifferentUserInStart -

############################################## colours, style and animations
group look "Colours, style and animations"
| Dark mode, accent colour and transparency are in Settings >
| Personalization > Colors.

choice visualStyle "Window style"
| Switches the style windows are drawn in, live. "Aero Lite" is the flat
| style Windows keeps hidden. "Leave it as it is" keeps whatever is in use,
| including a third-party style.
option keep "Leave it as it is":
option aero "Windows default":
  style %SystemRoot%\Resources\Themes\aero\aero.msstyles
option lite "Aero Lite":
  style %SystemRoot%\Resources\Themes\aero\aerolite.msstyles
detect-choice: HKCU\Software\Microsoft\Windows\CurrentVersion\ThemeManager | DllName
  aerolite.msstyles = lite
  aero.msstyles = aero

text accentColors "Extra accent colours"
| Up to eight colours added to the choices in Settings > Personalization >
| Colors, as #RRGGBB separated by commas. Windows 11 may not show them all.
set:
  accents {}
unset:
  accents
read: accents

text inactiveTitleColor "Title bar colour of windows in the background" format=colorRgb
| As RRGGBB. Used when Settings > Personalization > Colors > "Show accent
| colour on title bars" is on. Empty: the Windows default.
set:
  HKCU\Software\Microsoft\Windows\DWM | AccentColorInactive = dword:{abgr}
  notify ImmersiveColorSet
unset:
  HKCU\Software\Microsoft\Windows\DWM | AccentColorInactive -
  notify ImmersiveColorSet
read: HKCU\Software\Microsoft\Windows\DWM | AccentColorInactive as=abgr

toggle displayAnimation "No animation when a display changes" after=restart
| Skips the fade Windows 11 plays when a screen is connected or its
| resolution changes.
on:
  HKLM\SOFTWARE\Microsoft\Windows\Dwm | ForceDisableModeChangeAnimation = dword:1
off:
  HKLM\SOFTWARE\Microsoft\Windows\Dwm | ForceDisableModeChangeAnimation -

toggle slowAnimations "Slow window animations while Shift is held" after=signout
| Minimising or opening a window with Shift held plays it in slow motion, as
| in Windows 7. For fun, or for checking animations.
on:
  HKCU\Software\Microsoft\Windows\DWM | AnimationsShiftKey = dword:1
off:
  HKCU\Software\Microsoft\Windows\DWM | AnimationsShiftKey -

############################################################ fonts and sizes
group metrics "Fonts and sizes"
| The fonts and sizes of classic window parts, as Windows 7's Window Color
| and Appearance dialog set them. A font is written "Face, size in pixels",
| with ", bold" or ", italic" if wanted, e.g. Segoe UI, 12. Empty: the
| Windows default. Newer programs draw their own and don't follow these.
| They apply live. Windows defaults: icon spacing 75, menu height 19, scroll
| bars 17, title bars 22, border 1, border padding 4.

text systemFont "System font" after=signout format=fontFamily
| Replaces Segoe UI everywhere, the way Winaero Tweaker does it: the font is
| substituted and Segoe UI's own files are unregistered, so programs can't
| pick it directly. Empty restores Segoe UI. To see it before signing out,
| see How tweaks are applied > Show a new system font straight away.
set:
  HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\FontSubstitutes | Segoe UI = sz:{}
  HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts | Segoe UI (TrueType) = sz:
  HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts | Segoe UI Bold (TrueType) = sz:
  HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts | Segoe UI Bold Italic (TrueType) = sz:
  HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts | Segoe UI Italic (TrueType) = sz:
  HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts | Segoe UI Light (TrueType) = sz:
  HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts | Segoe UI Semibold (TrueType) = sz:
unset:
  HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\FontSubstitutes | Segoe UI -
  HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts | Segoe UI (TrueType) = sz:segoeui.ttf
  HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts | Segoe UI Bold (TrueType) = sz:segoeuib.ttf
  HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts | Segoe UI Bold Italic (TrueType) = sz:segoeuiz.ttf
  HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts | Segoe UI Italic (TrueType) = sz:segoeuii.ttf
  HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts | Segoe UI Light (TrueType) = sz:segoeuil.ttf
  HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts | Segoe UI Semibold (TrueType) = sz:seguisb.ttf
read: HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\FontSubstitutes | Segoe UI

text captionFont "Title bar font"
| In window title bars.
set:
  font caption {}
unset:
  font caption Segoe UI, 12
read: $WM | CaptionFont as=logfont

text menuFont "Menu font"
| In menu bars and right-click menus.
set:
  font menu {}
unset:
  font menu Segoe UI, 12
read: $WM | MenuFont as=logfont

text messageFont "Message box font"
| In message boxes and many dialogs.
set:
  font message {}
unset:
  font message Segoe UI, 12
read: $WM | MessageFont as=logfont

text statusFont "Status bar and tooltip font"
| In status bars and tooltips.
set:
  font status {}
unset:
  font status Segoe UI, 12
read: $WM | StatusFont as=logfont

text iconFont "Icon label font"
| Under desktop icons and in File Explorer's lists.
set:
  font icon {}
unset:
  font icon Segoe UI, 12
read: $WM | IconFont as=logfont

number captionHeight "Title bar height (px)" default=22 min=10 max=100
| The height of title bars and the size of their buttons.
set:
  metric captionHeight {}
read: $WM | CaptionHeight as=twips

number menuHeight "Menu height (px)" default=19 min=10 max=100
| The height of each row in menu bars.
set:
  metric menuHeight {}
read: $WM | MenuHeight as=twips

number scrollWidth "Scroll bar width (px)" default=17 min=8 max=100
| How wide vertical scroll bars are.
set:
  metric scrollWidth {}
read: $WM | ScrollWidth as=twips

number scrollHeight "Scroll bar button size (px)" default=17 min=8 max=100
| The size of the arrow buttons at the ends of scroll bars.
set:
  metric scrollHeight {}
read: $WM | ScrollHeight as=twips

number borderWidth "Window border width (px)" default=1 min=1 max=10
| Shows with the Aero Lite style; the default style draws its own borders.
set:
  metric borderWidth {}
read: $WM | BorderWidth as=twips

number borderPadding "Window border padding (px)" default=4 min=0 max=10
| Extra space around the window border, which also widens the area you can
| grab to resize.
set:
  metric borderPadding {}
read: $WM | PaddedBorderWidth as=twips

number iconSpacingH "Desktop icon spacing, across (px)" default=75 min=32 max=182
set:
  metric iconSpacingH {}
read: $WM | IconSpacing as=twips

number iconSpacingV "Desktop icon spacing, down (px)" default=75 min=32 max=182
set:
  metric iconSpacingV {}
read: $WM | IconVerticalSpacing as=twips

################################################ mouse, keyboard and windows
group input "Mouse, keyboard and windows"
| Snap windows itself and title bar shake are in Settings > System >
| Multitasking.

toggle snapDockMoving "Snap: dragging to a side fills half the screen"
| Needs Snap windows on in Settings. Off: dragging a window to the left or
| right edge leaves it where it is.
on:
  spi ui 0x0091 1
off:
  spi ui 0x0091 0
detect:
  $DESK | DockMoving = sz:1

toggle snapSizing "Snap: dragging the top edge to the screen stretches the window"
| Dragging a window's top or bottom border to the screen's edge makes it
| full height, keeping its width.
on:
  spi ui 0x008F 1
off:
  spi ui 0x008F 0
detect:
  $DESK | SnapSizing = sz:1

toggle snapDragMaximized "Snap: drag a maximised window to restore it"
| Off: a maximised window can't be dragged off the top of the screen.
on:
  spi ui 0x008D 1
off:
  spi ui 0x008D 0
detect:
  $DESK | DragFromMaximize = sz:1

toggle xmouseTracking "Focus follows the mouse"
| The window under the pointer becomes the active one, without a click.
on:
  spi pv 0x1001 1
off:
  spi pv 0x1001 0
detect:
  spiget 0x1000

number xmouseDelay "Focus follows the mouse: delay (ms)" default=0 min=0 max=9000
| How long the pointer rests on a window before it becomes active.
set:
  spi pv 0x2003 {}
read: spiget 0x2002

toggle xmouseRaise "Focus follows the mouse: bring the window to the front"
| Off: the window becomes active but stays behind the others.
on:
  spi pv 0x100D 1
off:
  spi pv 0x100D 0
detect:
  spiget 0x100C

choice wheelRouting "Mouse wheel scrolls"
| Settings > Bluetooth & devices > Mouse only switches between the first and
| last options.
option focus "The active window only":
  spi pv 0x201D 0
option hybrid "The active window, and Store apps under the pointer":
  spi pv 0x201D 1
option pointer "Whatever window is under the pointer":
  spi pv 0x201D 2
detect-choice: $DESK | MouseWheelRouting
  0 = focus
  1 = hybrid
  2 = pointer
default: hybrid

number menuShowDelay "Submenu delay (ms)" default=400 min=0 max=1000
| How long the pointer rests on a menu item before its submenu opens.
set:
  spi ui 0x006B {}
read: $DESK | MenuShowDelay

number dragThreshold "Drag starts after moving (px)" default=4 min=1 max=100
| How far the pointer moves with the button held before a drag begins.
| Higher stops accidental drags.
set:
  spi ui 0x004C {}
  spi ui 0x004D {}
read: $DESK | DragWidth

choice dragDrop "Dragging files with the left button"
| Windows moves files dragged within a drive and copies them between drives.
| These make it always do one thing (dragging with the right button still
| asks).
option default "Windows default (move on the same drive, copy between drives)":
  $CLS\* | DefaultDropEffect -
  $CLS\AllFilesystemObjects | DefaultDropEffect -
option copy "Always copy":
  $CLS\* | DefaultDropEffect = dword:1
  $CLS\AllFilesystemObjects | DefaultDropEffect = dword:1
option move "Always move":
  $CLS\* | DefaultDropEffect = dword:2
  $CLS\AllFilesystemObjects | DefaultDropEffect = dword:2
option link "Always make a shortcut":
  $CLS\* | DefaultDropEffect = dword:4
  $CLS\AllFilesystemObjects | DefaultDropEffect = dword:4
detect-choice: $CLS\AllFilesystemObjects | DefaultDropEffect
  1 = copy
  2 = move
  4 = link
default: default

toggle emojiAllLanguages "Emoji panel (Win + .) for every keyboard language" after=signout
| Windows only offers it for some keyboard languages.
on:
  HKLM\SOFTWARE\Microsoft\Input\Settings | EnableExpressiveInputShellHotkey = dword:1
off:
  HKLM\SOFTWARE\Microsoft\Input\Settings | EnableExpressiveInputShellHotkey -

text printScreenSound "Print Screen sound" format=filePath
| A .wav file played when you press Print Screen. Empty: no sound.
set:
  HKCU\AppEvents\Schemes\Apps\.Default\SnapShot\.Current | @ = sz:{}
unset:
  HKCU\AppEvents\Schemes\Apps\.Default\SnapShot\.Current | @ = sz:
read: HKCU\AppEvents\Schemes\Apps\.Default\SnapShot\.Current | @

text appKeyMail "Keyboard Mail key opens"
| For keyboards with extra keys. Empty: the Windows default. "none": the key
| does nothing. Anything else: that program or command. The same goes for
| the keys below.
set:
  $CUEXP\AppKey\15 | ShellExecute = sz:{cmd}
unset:
  $CUEXP\AppKey\15 | -
read: $CUEXP\AppKey\15 | ShellExecute

text appKeyCalculator "Keyboard Calculator key opens"
set:
  $CUEXP\AppKey\18 | ShellExecute = sz:{cmd}
unset:
  $CUEXP\AppKey\18 | -
read: $CUEXP\AppKey\18 | ShellExecute

text appKeyComputer "Keyboard My Computer key opens"
set:
  $CUEXP\AppKey\17 | ShellExecute = sz:{cmd}
unset:
  $CUEXP\AppKey\17 | -
read: $CUEXP\AppKey\17 | ShellExecute

text appKeyBrowser "Keyboard Browser home key opens"
set:
  $CUEXP\AppKey\7 | ShellExecute = sz:{cmd}
unset:
  $CUEXP\AppKey\7 | -
read: $CUEXP\AppKey\7 | ShellExecute

text appKeyMedia "Keyboard Media key opens"
set:
  $CUEXP\AppKey\16 | ShellExecute = sz:{cmd}
unset:
  $CUEXP\AppKey\16 | -
read: $CUEXP\AppKey\16 | ShellExecute

text appKeySearch "Keyboard Search key opens"
set:
  $CUEXP\AppKey\5 | ShellExecute = sz:{cmd}
unset:
  $CUEXP\AppKey\5 | -
read: $CUEXP\AppKey\5 | ShellExecute

############################################################## file explorer
group explorer "File Explorer"
| Folder Options (View > Options in File Explorer) has hidden files, file
| extensions, drive letters on or off, Libraries in the navigation pane and
| what File Explorer opens to. These are the ones it doesn't have.

toggle ribbon "Windows 10 ribbon instead of the command bar" after=explorer
| File Explorer gets the Windows 10 ribbon back in place of Windows 11's
| command bar.
on:
  $CLS\CLSID\{2aa9162e-c906-4dd9-ad0b-3d24a8eef5a0} | @ = sz:CLSID_ItemsViewAdapter
  $CLS\CLSID\{2aa9162e-c906-4dd9-ad0b-3d24a8eef5a0}\InProcServer32 | @ = sz:C:\Windows\System32\Windows.UI.FileExplorer.dll_
  $CLS\CLSID\{2aa9162e-c906-4dd9-ad0b-3d24a8eef5a0}\InProcServer32 | ThreadingModel = sz:Apartment
  $CLS\CLSID\{6480100b-5a83-4d1e-9f69-8ae5a88e9a33} | @ = sz:File Explorer Xaml Island View Adapter
  $CLS\CLSID\{6480100b-5a83-4d1e-9f69-8ae5a88e9a33}\InProcServer32 | @ = sz:C:\Windows\System32\Windows.UI.FileExplorer.dll_
  $CLS\CLSID\{6480100b-5a83-4d1e-9f69-8ae5a88e9a33}\InProcServer32 | ThreadingModel = sz:Apartment
off:
  $CLS\CLSID\{2aa9162e-c906-4dd9-ad0b-3d24a8eef5a0} | -
  $CLS\CLSID\{6480100b-5a83-4d1e-9f69-8ae5a88e9a33} | -
detect:
  $CLS\CLSID\{2aa9162e-c906-4dd9-ad0b-3d24a8eef5a0}\InProcServer32 | +

choice startFolder "File Explorer opens to" after=explorer
| Folder Options offers Home and This PC; this adds Downloads and a folder
| of your own.
uses: explorer.startFolderPath
option home "Home":
  $ADV | LaunchTo = dword:2
  $CLS\CLSID\{52205fd8-5dfb-447d-801a-d0b52f2e83e1} | -
option thispc "This PC":
  $ADV | LaunchTo = dword:1
  $CLS\CLSID\{52205fd8-5dfb-447d-801a-d0b52f2e83e1} | -
option downloads "Downloads":
  $ADV | LaunchTo = dword:3
  $CLS\CLSID\{52205fd8-5dfb-447d-801a-d0b52f2e83e1} | -
option custom "The folder below":
  $ADV | LaunchTo = dword:1
  $CLS\CLSID\{52205fd8-5dfb-447d-801a-d0b52f2e83e1}\shell\opennewwindow\command | @ = sz:explorer.exe "{@explorer.startFolderPath}"
  $CLS\CLSID\{52205fd8-5dfb-447d-801a-d0b52f2e83e1}\shell\opennewwindow\command | DelegateExecute = sz:
detect-choice: $ADV | LaunchTo
  2 = home
  1 = thispc
  3 = downloads
default: home

text startFolderPath "File Explorer opens to: your own folder" format=folderPath
| Used when "File Explorer opens to" is "The folder below".

toggle classicSearch "Classic search" after=explorer
| File Explorer's search box looks only on this PC, with the old search
| filters, and stops suggesting web results.
on:
  $CLS\CLSID\{1d64637d-31e9-4b06-9124-e83fb178ac6e}\TreatAs | @ = sz:{64bc32b5-4eec-4de7-972d-bd8bd0324537}
  $CLS\WOW6432Node\CLSID\{1d64637d-31e9-4b06-9124-e83fb178ac6e}\TreatAs | @ = sz:{64bc32b5-4eec-4de7-972d-bd8bd0324537}
off:
  $CLS\CLSID\{1d64637d-31e9-4b06-9124-e83fb178ac6e} | -
  $CLS\WOW6432Node\CLSID\{1d64637d-31e9-4b06-9124-e83fb178ac6e} | -
detect:
  $CLS\CLSID\{1d64637d-31e9-4b06-9124-e83fb178ac6e}\TreatAs | @ = sz:{64bc32b5-4eec-4de7-972d-bd8bd0324537}

toggle noSearchHistory "No search history in File Explorer" after=explorer
| The search box stops remembering and suggesting what you searched for.
on:
  $CUWPOL\Explorer | DisableSearchBoxSuggestions = dword:1
off:
  $CUWPOL\Explorer | DisableSearchBoxSuggestions -

toggle autoComplete "Complete paths as you type"
| In the Run box, the address bar, and Open and Save dialogs.
on:
  $CUEXP\AutoComplete | Append Completion = sz:yes
off:
  $CUEXP\AutoComplete | Append Completion = sz:no
detect:
  $CUEXP\AutoComplete | Append Completion = sz:yes

toggle noFolderTypeDiscovery "Same view in every folder" after=explorer
| Every folder uses the same general view, instead of a pictures or music
| layout Windows guesses from its contents. Views you set yourself are kept.
on:
  $CLS\Local Settings\Software\Microsoft\Windows\Shell\Bags\AllFolders\Shell | FolderType = sz:NotSpecified
off:
  $CLS\Local Settings\Software\Microsoft\Windows\Shell\Bags\AllFolders\Shell | FolderType -

number folderViews "Folder views to remember" default=5000 min=5000 max=20000
| How many folders keep their own view (icons, details, sorting) before the
| oldest are forgotten.
set:
  $CLS\Local Settings\Software\Microsoft\Windows\Shell | BagMRU Size = dword:{}
unset:
  $CLS\Local Settings\Software\Microsoft\Windows\Shell | BagMRU Size -
read: $CLS\Local Settings\Software\Microsoft\Windows\Shell | BagMRU Size

toggle doForAll "\"Do this for all current items\" ticked by default"
| When copying runs into several conflicts, the box to do the same for all
| of them starts ticked.
on:
  $CUEXP\OperationStatusManager | ConfirmationCheckBoxDoForAll = dword:1
off:
  $CUEXP\OperationStatusManager | ConfirmationCheckBoxDoForAll -

toggle removableRecycleBin "Recycle Bin on USB drives" after=explorer
| Files deleted from USB sticks and memory cards go to the Recycle Bin
| instead of being deleted straight away.
on:
  $CUPEXP | RecycleBinDrives = dword:0xffffffff
off:
  $CUPEXP | RecycleBinDrives -

number jumpListItems "Items in jump lists" default=12 min=2 max=30 after=explorer
| How many recent files show when you right-click a program on the taskbar.
set:
  $ADV | JumpListItems_Maximum = dword:{}
unset:
  $ADV | JumpListItems_Maximum -
read: $ADV | JumpListItems_Maximum

toggle keepThumbnailCache "Keep picture thumbnails between restarts"
| Windows clears its thumbnail cache now and then, so folders of pictures
| load slowly again; this keeps it.
on:
  $LMEXP\VolumeCaches\Thumbnail Cache | Autorun = dword:0
  HKLM\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Explorer\VolumeCaches\Thumbnail Cache | Autorun = dword:0
off:
  $LMEXP\VolumeCaches\Thumbnail Cache | Autorun = dword:1
  HKLM\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Explorer\VolumeCaches\Thumbnail Cache | Autorun = dword:1
detect:
  $LMEXP\VolumeCaches\Thumbnail Cache | Autorun = dword:0

################################# file explorer: navigation pane and this pc
group navpane "File Explorer: navigation pane and This PC"
| What shows in File Explorer's left pane, and in This PC.

toggle navHome "Navigation pane: Home" after=explorer
on:
  $CLS\CLSID\{f874310e-b6b7-47dc-bc84-b9e6b38f5903} | System.IsPinnedToNameSpaceTree -
off:
  $CLS\CLSID\{f874310e-b6b7-47dc-bc84-b9e6b38f5903} | System.IsPinnedToNameSpaceTree = dword:0
detect:
  $CLS\CLSID\{f874310e-b6b7-47dc-bc84-b9e6b38f5903} | System.IsPinnedToNameSpaceTree -

toggle navGallery "Navigation pane: Gallery" after=explorer
on:
  $CLS\CLSID\{e88865ea-0e1c-4e20-9aa6-edcd0212c87c} | System.IsPinnedToNameSpaceTree -
off:
  $CLS\CLSID\{e88865ea-0e1c-4e20-9aa6-edcd0212c87c} | System.IsPinnedToNameSpaceTree = dword:0
detect:
  $CLS\CLSID\{e88865ea-0e1c-4e20-9aa6-edcd0212c87c} | System.IsPinnedToNameSpaceTree -

toggle navOneDrive "Navigation pane: OneDrive" after=explorer
on:
  $CLS\CLSID\{018D5C66-4533-4307-9B53-224DE2ED1FE6} | System.IsPinnedToNameSpaceTree = dword:1
off:
  $CLS\CLSID\{018D5C66-4533-4307-9B53-224DE2ED1FE6} | System.IsPinnedToNameSpaceTree = dword:0

toggle navThisPc "Navigation pane: This PC" after=explorer
on:
  $CLS\CLSID\{20D04FE0-3AEA-1069-A2D8-08002B30309D} | System.IsPinnedToNameSpaceTree -
off:
  $CLS\CLSID\{20D04FE0-3AEA-1069-A2D8-08002B30309D} | System.IsPinnedToNameSpaceTree = dword:0
detect:
  $CLS\CLSID\{20D04FE0-3AEA-1069-A2D8-08002B30309D} | System.IsPinnedToNameSpaceTree -

toggle navNetwork "Navigation pane: Network" after=explorer
on:
  $CLS\CLSID\{F02C1A0D-BE21-4350-88B0-7367FC96EF3C} | System.IsPinnedToNameSpaceTree -
off:
  $CLS\CLSID\{F02C1A0D-BE21-4350-88B0-7367FC96EF3C} | System.IsPinnedToNameSpaceTree = dword:0
detect:
  $CLS\CLSID\{F02C1A0D-BE21-4350-88B0-7367FC96EF3C} | System.IsPinnedToNameSpaceTree -

toggle navRemovable "Navigation pane: USB drives on their own" after=explorer
| On: USB drives also show as their own entries. Off: only under This PC.
on:
  $LMEXP\Desktop\NameSpace\DelegateFolders\{F5FB2C77-0E2F-4A16-A381-3E560C68BC83} | @ = sz:Removable Drives
  HKLM\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Explorer\Desktop\NameSpace\DelegateFolders\{F5FB2C77-0E2F-4A16-A381-3E560C68BC83} | @ = sz:Removable Drives
off:
  $LMEXP\Desktop\NameSpace\DelegateFolders\{F5FB2C77-0E2F-4A16-A381-3E560C68BC83} | -
  HKLM\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Explorer\Desktop\NameSpace\DelegateFolders\{F5FB2C77-0E2F-4A16-A381-3E560C68BC83} | -
detect:
  $LMEXP\Desktop\NameSpace\DelegateFolders\{F5FB2C77-0E2F-4A16-A381-3E560C68BC83} | +

text navPaneFolders "Navigation pane: your own folders" after=explorer
| Folders added to the left pane, as Name > Path > Icon, with | between
| them. The icon is optional, e.g. Projects > D:\Projects
set:
  folders Desktop {}
unset:
  folders Desktop
read: folders Desktop

toggle thisPcDesktop "This PC: Desktop folder" after=explorer
on:
  $LMNS\{B4BFCC3A-DB2C-424C-B029-7FE99A87C641} | HiddenByDefault -
  $WOWNS\{B4BFCC3A-DB2C-424C-B029-7FE99A87C641} | HiddenByDefault -
off:
  $LMNS\{B4BFCC3A-DB2C-424C-B029-7FE99A87C641} | HiddenByDefault = dword:1
  $WOWNS\{B4BFCC3A-DB2C-424C-B029-7FE99A87C641} | HiddenByDefault = dword:1

toggle thisPcDocuments "This PC: Documents folder" after=explorer
on:
  $LMNS\{A8CDFF1C-4878-43be-B5FD-F8091C1C60D0} | HiddenByDefault -
  $WOWNS\{A8CDFF1C-4878-43be-B5FD-F8091C1C60D0} | HiddenByDefault -
off:
  $LMNS\{A8CDFF1C-4878-43be-B5FD-F8091C1C60D0} | HiddenByDefault = dword:1
  $WOWNS\{A8CDFF1C-4878-43be-B5FD-F8091C1C60D0} | HiddenByDefault = dword:1

toggle thisPcDownloads "This PC: Downloads folder" after=explorer
on:
  $LMNS\{374DE290-123F-4565-9164-39C4925E467B} | HiddenByDefault -
  $WOWNS\{374DE290-123F-4565-9164-39C4925E467B} | HiddenByDefault -
off:
  $LMNS\{374DE290-123F-4565-9164-39C4925E467B} | HiddenByDefault = dword:1
  $WOWNS\{374DE290-123F-4565-9164-39C4925E467B} | HiddenByDefault = dword:1

toggle thisPcMusic "This PC: Music folder" after=explorer
on:
  $LMNS\{1CF1260C-4DD0-4ebb-811F-33C572699FDE} | HiddenByDefault -
  $WOWNS\{1CF1260C-4DD0-4ebb-811F-33C572699FDE} | HiddenByDefault -
off:
  $LMNS\{1CF1260C-4DD0-4ebb-811F-33C572699FDE} | HiddenByDefault = dword:1
  $WOWNS\{1CF1260C-4DD0-4ebb-811F-33C572699FDE} | HiddenByDefault = dword:1

toggle thisPcPictures "This PC: Pictures folder" after=explorer
on:
  $LMNS\{3ADD1653-EB32-4cb0-BBD7-DFA0ABB5ACCA} | HiddenByDefault -
  $WOWNS\{3ADD1653-EB32-4cb0-BBD7-DFA0ABB5ACCA} | HiddenByDefault -
off:
  $LMNS\{3ADD1653-EB32-4cb0-BBD7-DFA0ABB5ACCA} | HiddenByDefault = dword:1
  $WOWNS\{3ADD1653-EB32-4cb0-BBD7-DFA0ABB5ACCA} | HiddenByDefault = dword:1

toggle thisPcVideos "This PC: Videos folder" after=explorer
on:
  $LMNS\{A0953C92-50DC-43bf-BE83-3742FED03C9C} | HiddenByDefault -
  $WOWNS\{A0953C92-50DC-43bf-BE83-3742FED03C9C} | HiddenByDefault -
off:
  $LMNS\{A0953C92-50DC-43bf-BE83-3742FED03C9C} | HiddenByDefault = dword:1
  $WOWNS\{A0953C92-50DC-43bf-BE83-3742FED03C9C} | HiddenByDefault = dword:1

text thisPcFolders "This PC: your own folders" after=explorer
| Folders added to This PC, as Name > Path > Icon, with | between them. The
| icon is optional, e.g. Downloads > X:\Downloads > C:\Icons\dl.ico
set:
  folders MyComputer {}
unset:
  folders MyComputer
read: folders MyComputer

choice driveLetters "Drive letters in This PC" after=explorer
| Folder Options can only show or hide them; this can also put them first.
option after "After the name (Windows default)":
  $CUEXP | ShowDriveLettersFirst -
  $LMEXP | ShowDriveLettersFirst -
option before "Before the name":
  $CUEXP | ShowDriveLettersFirst = dword:4
option network "Before the name for network drives only":
  $CUEXP | ShowDriveLettersFirst = dword:1
option hidden "Hidden":
  $CUEXP | ShowDriveLettersFirst = dword:2
detect-choice: $CUEXP | ShowDriveLettersFirst
  4 = before
  1 = network
  2 = hidden
default: after

text hiddenDrives "Hidden drives" after=explorer
| Drive letters hidden from This PC, e.g. F,H,I. They still open when typed
| in the address bar. Empty: all drives show.
set:
  $LMPEXP | NoDrives = dword:{drives}
unset:
  $LMPEXP | NoDrives -
read: $LMPEXP | NoDrives as=drives

text librariesName "Libraries: name" after=explorer
| Empty: the Windows default. Libraries themselves show once Folder Options
| > Show libraries is on.
set:
  $CLS\CLSID\{031E4825-7B94-4dc3-B131-E946B44C8DD5} | LocalizedString = sz:{}
unset:
  $CLS\CLSID\{031E4825-7B94-4dc3-B131-E946B44C8DD5} | LocalizedString -
read: $CLS\CLSID\{031E4825-7B94-4dc3-B131-E946B44C8DD5} | LocalizedString

text librariesIcon "Libraries: icon" after=explorer format=filePath
| An .ico file. Empty: the Windows default.
set:
  $CLS\CLSID\{031E4825-7B94-4dc3-B131-E946B44C8DD5}\DefaultIcon | @ = sz:{}
unset:
  $CLS\CLSID\{031E4825-7B94-4dc3-B131-E946B44C8DD5}\DefaultIcon | -
read: $CLS\CLSID\{031E4825-7B94-4dc3-B131-E946B44C8DD5}\DefaultIcon | @

############################################ icons, shortcuts and thumbnails
group icons "Icons, shortcuts and thumbnails"

text shortcutArrow "Shortcut arrow" after=explorer
| The arrow on shortcut icons. Empty: the Windows default. "none": no arrow.
| "classic": Windows XP's arrow. Or an .ico file.
set:
  shellicon 29 {}
unset:
  shellicon 29
read: $LMEXP\Shell Icons | 29 as=shellicon

toggle noShortcutText "No \" - Shortcut\" on new shortcuts"
on:
  $CUEXP\NamingTemplates | ShortcutNameTemplate = sz:"%s.lnk"
off:
  $CUEXP\NamingTemplates | ShortcutNameTemplate -
detect:
  $CUEXP\NamingTemplates | ShortcutNameTemplate = sz:"%s.lnk"

text compressedOverlay "Compressed file arrows" after=explorer
| The blue arrows on files NTFS has compressed. Empty: the Windows default.
| "none": no arrows. Or an .ico file.
set:
  shellicon 179 {}
unset:
  shellicon 179
read: $LMEXP\Shell Icons | 179 as=shellicon

text driveIcon "One icon for every drive" after=explorer format=filePath
| An .ico file used for all drives. Empty: the Windows default.
set:
  shellicon 8 {}
unset:
  shellicon 8
read: $LMEXP\Shell Icons | 8 as=shellicon

text driveIcons "Icons for single drives" after=explorer
| Letter and .ico pairs, e.g. D=C:\Icons\games.ico|E=C:\Icons\media.ico.
| These win over the one above.
set:
  driveicons {}
unset:
  driveicons
read: driveicons

toggle noFolderThumbnails "Plain folder icons" after=explorer
| Folders show a plain icon instead of a preview of what's in them; files
| keep their thumbnails.
on:
  $CLS\Folder\ShellEx\{e357fccd-a995-4576-b01f-234630154e96} | @ = sz:
off:
  $CLS\Folder\ShellEx\{e357fccd-a995-4576-b01f-234630154e96} | -
detect:
  $CLS\Folder\ShellEx\{e357fccd-a995-4576-b01f-234630154e96} | +

choice thumbnailFrame "Picture thumbnail frame" after=explorer
| The frame drawn around picture thumbnails.
option default "Windows default":
  $CLS\SystemFileAssociations\image | Treatment -
option none "None":
  $CLS\SystemFileAssociations\image | Treatment = dword:0
option shadow "Drop shadow":
  $CLS\SystemFileAssociations\image | Treatment = dword:1
option photo "Photo border":
  $CLS\SystemFileAssociations\image | Treatment = dword:2
option film "Film strip":
  $CLS\SystemFileAssociations\image | Treatment = dword:3
detect-choice: $CLS\SystemFileAssociations\image | Treatment
  0 = none
  1 = shadow
  2 = photo
  3 = film
default: default

number iconCacheKB "Icon cache size (KB)" default=500 min=100 max=100000 after=restart
| Raise it if icons go blank or turn into the wrong ones.
set:
  $LMEXP | Max Cached Icons = sz:{}
unset:
  $LMEXP | Max Cached Icons -
read: $LMEXP | Max Cached Icons

##################################### right-click menu: windows' own entries
group menu "Right-click menu: Windows' own entries"
| Hide the entries Windows and its apps add to right-click menus, or change
| how they behave.

toggle classicMenus "Full right-click menus" after=explorer
| Right-click menus open in full, as in Windows 10, without "Show more
| options". The entries below show in either menu.
on:
  $CLS\CLSID\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}\InprocServer32 | @ = sz:
off:
  $CLS\CLSID\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2} | -
detect:
  $CLS\CLSID\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}\InprocServer32 | +

number multiSelectLimit "Open, Print and Edit for up to this many files" default=15 min=5 max=200
| With more files selected than this, Windows leaves Open, Print and Edit
| out of the menu.
set:
  $CUEXP | MultipleInvokePromptMinimum = dword:{}
unset:
  $CUEXP | MultipleInvokePromptMinimum -
read: $CUEXP | MultipleInvokePromptMinimum

text editImageApp "Program for Edit on pictures"
| What right-click > Edit opens pictures with, as a command line with "%1"
| for the file. Empty: Paint.
set:
  $LMCLS\SystemFileAssociations\image\shell\edit\command | @ = expand:{}
unset:
  $LMCLS\SystemFileAssociations\image\shell\edit\command | @ = expand:"%systemroot%\system32\mspaint.exe" "%1"
read: $LMCLS\SystemFileAssociations\image\shell\edit\command | @

toggle runAsUserAlways "\"Run as different user\" without Shift"
| Windows only shows it on programs while Shift is held.
on:
  $CLS\exefile\shell\runasuser | @ = sz:@shell32.dll,-50944
  $CLS\exefile\shell\runasuser\command | DelegateExecute = sz:{ea72d00e-4960-42fa-ba92-7792a7944c1d}
  $CLS\Msi.Package\shell\runasuser | @ = sz:@shell32.dll,-50944
  $CLS\Msi.Package\shell\runasuser\command | DelegateExecute = sz:{ea72d00e-4960-42fa-ba92-7792a7944c1d}
  $CLS\batfile\shell\runasuser | @ = sz:@shell32.dll,-50944
  $CLS\batfile\shell\runasuser\command | DelegateExecute = sz:{ea72d00e-4960-42fa-ba92-7792a7944c1d}
  $CLS\cmdfile\shell\runasuser | @ = sz:@shell32.dll,-50944
  $CLS\cmdfile\shell\runasuser\command | DelegateExecute = sz:{ea72d00e-4960-42fa-ba92-7792a7944c1d}
off:
  $CLS\exefile\shell\runasuser | -
  $CLS\Msi.Package\shell\runasuser | -
  $CLS\batfile\shell\runasuser | -
  $CLS\cmdfile\shell\runasuser | -
detect:
  $CLS\exefile\shell\runasuser\command | +

toggle newProcessAlways "\"Open in new process\" without Shift"
| Opens a folder in a separate Explorer, so a crash there can't take the
| taskbar down. Windows only shows it while Shift is held.
on:
  $CLS\Folder\shell\opennewprocess | MUIVerb = sz:@shell32.dll,-8518
  $CLS\Folder\shell\opennewprocess | MultiSelectModel = sz:Document
  $CLS\Folder\shell\opennewprocess | LaunchExplorerFlags = dword:3
  $CLS\Folder\shell\opennewprocess | ExplorerHost = sz:{ceff45ee-c862-41de-aee2-a022c81eda92}
  $CLS\Folder\shell\opennewprocess\command | DelegateExecute = sz:{11dbb47c-a525-400b-9e80-a54615a090c0}
off:
  $CLS\Folder\shell\opennewprocess | -

toggle removeAskCopilot "Remove \"Ask Copilot\""
on:
  $BLOCK | {CB3B0003-8088-4EDE-8769-8B354AB2FF8C} = sz:
off:
  $BLOCK | {CB3B0003-8088-4EDE-8769-8B354AB2FF8C} -
  $LMBLOCK | {CB3B0003-8088-4EDE-8769-8B354AB2FF8C} -
detect:
  $BLOCK | {CB3B0003-8088-4EDE-8769-8B354AB2FF8C} = sz:
detect:
  $LMBLOCK | {CB3B0003-8088-4EDE-8769-8B354AB2FF8C} = sz:

toggle removeClipchamp "Remove \"Edit in Clipchamp\""
on:
  $BLOCK | {8AB635F8-9A67-4698-AB99-784AD929F3B4} = sz:
off:
  $BLOCK | {8AB635F8-9A67-4698-AB99-784AD929F3B4} -
  $LMBLOCK | {8AB635F8-9A67-4698-AB99-784AD929F3B4} -
detect:
  $BLOCK | {8AB635F8-9A67-4698-AB99-784AD929F3B4} = sz:
detect:
  $LMBLOCK | {8AB635F8-9A67-4698-AB99-784AD929F3B4} = sz:

toggle removeEditNotepad "Remove \"Edit in Notepad\""
on:
  $BLOCK | {CA6CC9F1-867A-481E-951E-A28C5E4F01EA} = sz:
off:
  $BLOCK | {CA6CC9F1-867A-481E-951E-A28C5E4F01EA} -
