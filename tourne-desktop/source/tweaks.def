  key = enabled
default: disabled

toggle ps1MenuPwsh "PowerShell scripts: PowerShell 7 in that menu"
| Adds "Run with PowerShell 7" to the menu above, when PowerShell 7 is
| installed.

toggle runAsVbs "VBScript files: Run as administrator"
on:
  $CLS\VBSFile\Shell\runas | HasLUAShield = sz:
  $CLS\VBSFile\Shell\runas\command | @ = sz:WScript.exe "%1" %*
off:
  $CLS\VBSFile\Shell\runas | -

toggle openWithBatch "Batch files: Open with"
| Windows leaves Open with out for .bat and .cmd files.
on:
  $CLS\SystemFileAssociations\.bat\shell\TourneOpenWith | MUIVerb = sz:Open with...
  $CLS\SystemFileAssociations\.bat\shell\TourneOpenWith\command | @ = expand:"%SystemRoot%\System32\rundll32.exe" "%SystemRoot%\System32\shell32.dll",OpenAs_RunDLL %1
  $CLS\SystemFileAssociations\.cmd\shell\TourneOpenWith | MUIVerb = sz:Open with...
  $CLS\SystemFileAssociations\.cmd\shell\TourneOpenWith\command | @ = expand:"%SystemRoot%\System32\rundll32.exe" "%SystemRoot%\System32\shell32.dll",OpenAs_RunDLL %1
off:
  $CLS\SystemFileAssociations\.bat\shell\TourneOpenWith | -
  $CLS\SystemFileAssociations\.cmd\shell\TourneOpenWith | -
  $CLS\batfile\shell\TourneOpenWith | -
  $CLS\cmdfile\shell\TourneOpenWith | -
detect:
  $CLS\SystemFileAssociations\.bat\shell\TourneOpenWith\command | +

toggle runAsMsi "Installers (.msi): Install as administrator"
on:
  $CLS\Msi.Package\shell\runas | MUIVerb = sz:Install as administrator
  $CLS\Msi.Package\shell\runas | HasLUAShield = sz:
  $CLS\Msi.Package\shell\runas\command | @ = sz:msiexec.exe /i "%1"
off:
  $CLS\Msi.Package\shell\runas | -

toggle msiExtract "Installers (.msi): Extract the contents"
| Unpacks an installer into a folder beside it, without installing.
on:
  $CLS\Msi.Package\shell\Extract | MUIVerb = sz:Extract the contents
  $CLS\Msi.Package\shell\Extract\command | @ = sz:msiexec.exe /a "%1" /qb TARGETDIR="%1 Contents"
off:
  $CLS\Msi.Package\shell\Extract | -
  $LMCLS\Msi.Package\shell\Extract | -
detect:
  $CLS\Msi.Package\shell\Extract\command | +
detect:
  $LMCLS\Msi.Package\shell\Extract\command | +

toggle cabInstall "Update packages (.cab): Install"
| Installs a Windows update or language pack from a .cab file.
on:
  $CLS\CABFolder\Shell\TourneInstall | MUIVerb = sz:Install this update
  $CLS\CABFolder\Shell\TourneInstall | HasLUAShield = sz:
  $CLS\CABFolder\Shell\TourneInstall\command | @ = sz:$PS "Start-Process dism.exe -Verb RunAs -ArgumentList '/Online','/Add-Package','/PackagePath:\"%1\"'"
off:
  $CLS\CABFolder\Shell\TourneInstall | -

toggle bitlockerLock "Drives: Lock with BitLocker"
| Locks an unlocked BitLocker drive again without restarting.
on:
  $CLS\Drive\shell\TourneLockBde | MUIVerb = sz:Lock drive
  $CLS\Drive\shell\TourneLockBde | AppliesTo = sz:System.Volume.BitLockerProtection:=1
  $CLS\Drive\shell\TourneLockBde | HasLUAShield = sz:
  $CLS\Drive\shell\TourneLockBde\command | @ = sz:$PS "Start-Process manage-bde.exe -Verb RunAs -ArgumentList '-lock','%1','-ForceDismount'"
off:
  $CLS\Drive\shell\TourneLockBde | -

toggle advancedSystemProps "This PC: Advanced system properties"
| Performance, environment variables, startup and recovery.
on:
  $THISPC\advproperties | MUIVerb = sz:Advanced system properties
  $THISPC\advproperties | Icon = sz:SystemPropertiesAdvanced.exe
  $THISPC\advproperties\command | @ = sz:SystemPropertiesAdvanced.exe
off:
  $THISPC\advproperties | -
detect:
  $THISPC\advproperties\command | +

toggle classicSystemProps "This PC: System properties (classic)"
| The old System Properties window: computer name, hardware, remote.
on:
  $THISPC\TourneSysProps | MUIVerb = sz:System properties (classic)
  $THISPC\TourneSysProps | Icon = sz:sysdm.cpl
  $THISPC\TourneSysProps\command | @ = sz:rundll32.exe shell32.dll,Control_RunDLL sysdm.cpl
off:
  $THISPC\TourneSysProps | -

################################################## right-click menu: desktop
group menuDesktop "Right-click menu: desktop"
| Shortcuts added to the menu you get by right-clicking the desktop. Each
| one is off until you switch it on. New entries are for your account only
| and show straight away; entries Winaero Tweaker added are taken over, so
| turning one off removes it too.

toggle settingsMenu "Settings"
on:
  $DB\TourneSettings | MUIVerb = sz:Settings
  $DB\TourneSettings | SubCommands = sz:
  $DB\TourneSettings | Icon = sz:shell32.dll,-16826
  $DB\TourneSettings\shell\01home | MUIVerb = sz:Settings
  $DB\TourneSettings\shell\01home\command | @ = sz:explorer.exe ms-settings:
  $DB\TourneSettings\shell\02system | MUIVerb = sz:System
  $DB\TourneSettings\shell\02system\command | @ = sz:explorer.exe ms-settings:display
  $DB\TourneSettings\shell\03devices | MUIVerb = sz:Bluetooth and devices
  $DB\TourneSettings\shell\03devices\command | @ = sz:explorer.exe ms-settings:bluetooth
