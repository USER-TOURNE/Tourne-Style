  $CLS\SystemFileAssociations\.ps1\Shell\TourneRunModify | -
option enabled "On":
  $CLS\SystemFileAssociations\.ps1\Shell\TourneRunModify | -
  $CLS\SystemFileAssociations\.ps1\Shell\TourneRunModify | MUIVerb = sz:Run or modify
  $CLS\SystemFileAssociations\.ps1\Shell\TourneRunModify | SubCommands = sz:
  $CLS\SystemFileAssociations\.ps1\Shell\TourneRunModify | Icon = sz:powershell.exe
  $CLS\SystemFileAssociations\.ps1\Shell\TourneRunModify\shell\1run | MUIVerb = sz:Run with PowerShell
  $CLS\SystemFileAssociations\.ps1\Shell\TourneRunModify\shell\1run\command | @ = sz:powershell.exe -NoProfile -ExecutionPolicy Bypass -NoExit -File "%1"
  $CLS\SystemFileAssociations\.ps1\Shell\TourneRunModify\shell\2admin | MUIVerb = sz:Run as administrator
  $CLS\SystemFileAssociations\.ps1\Shell\TourneRunModify\shell\2admin | HasLUAShield = sz:
  $CLS\SystemFileAssociations\.ps1\Shell\TourneRunModify\shell\2admin\command | @ = sz:$PS "Start-Process powershell.exe -Verb RunAs -ArgumentList '-NoProfile','-ExecutionPolicy','Bypass','-NoExit','-File','\"%1\"'"
  $CLS\SystemFileAssociations\.ps1\Shell\TourneRunModify\shell\3ise | MUIVerb = sz:Edit with PowerShell ISE
  $CLS\SystemFileAssociations\.ps1\Shell\TourneRunModify\shell\3ise\command | @ = sz:powershell_ise.exe "%1"
  $CLS\SystemFileAssociations\.ps1\Shell\TourneRunModify\shell\4notepad | MUIVerb = sz:Edit in Notepad
  $CLS\SystemFileAssociations\.ps1\Shell\TourneRunModify\shell\4notepad\command | @ = sz:notepad.exe "%1"
  pwsh {@menuFiles.ps1MenuPwsh}
option shift "On, with Shift held":
  $CLS\SystemFileAssociations\.ps1\Shell\TourneRunModify | -
  $CLS\SystemFileAssociations\.ps1\Shell\TourneRunModify | MUIVerb = sz:Run or modify
  $CLS\SystemFileAssociations\.ps1\Shell\TourneRunModify | Extended = sz:
  $CLS\SystemFileAssociations\.ps1\Shell\TourneRunModify | SubCommands = sz:
  $CLS\SystemFileAssociations\.ps1\Shell\TourneRunModify | Icon = sz:powershell.exe
  $CLS\SystemFileAssociations\.ps1\Shell\TourneRunModify\shell\1run | MUIVerb = sz:Run with PowerShell
  $CLS\SystemFileAssociations\.ps1\Shell\TourneRunModify\shell\1run\command | @ = sz:powershell.exe -NoProfile -ExecutionPolicy Bypass -NoExit -File "%1"
  $CLS\SystemFileAssociations\.ps1\Shell\TourneRunModify\shell\2admin | MUIVerb = sz:Run as administrator
  $CLS\SystemFileAssociations\.ps1\Shell\TourneRunModify\shell\2admin | HasLUAShield = sz:
  $CLS\SystemFileAssociations\.ps1\Shell\TourneRunModify\shell\2admin\command | @ = sz:$PS "Start-Process powershell.exe -Verb RunAs -ArgumentList '-NoProfile','-ExecutionPolicy','Bypass','-NoExit','-File','\"%1\"'"
  $CLS\SystemFileAssociations\.ps1\Shell\TourneRunModify\shell\3ise | MUIVerb = sz:Edit with PowerShell ISE
  $CLS\SystemFileAssociations\.ps1\Shell\TourneRunModify\shell\3ise\command | @ = sz:powershell_ise.exe "%1"
  $CLS\SystemFileAssociations\.ps1\Shell\TourneRunModify\shell\4notepad | MUIVerb = sz:Edit in Notepad
  $CLS\SystemFileAssociations\.ps1\Shell\TourneRunModify\shell\4notepad\command | @ = sz:notepad.exe "%1"
  pwsh {@menuFiles.ps1MenuPwsh}
detect-choice: $CLS\SystemFileAssociations\.ps1\Shell\TourneRunModify | Extended
