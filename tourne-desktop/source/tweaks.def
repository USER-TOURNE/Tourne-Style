############################## right-click menu: files, folders and programs
group menuFiles "Right-click menu: files, folders and programs"
| Entries added to the menus of files, folders, drives and programs. Each
| one is off until you switch it on. New entries are for your account only
| and show straight away; entries Winaero Tweaker added are taken over, so
| turning one off removes it too.

choice cmdHere "Folders: Command prompt here"
| "With Shift held" keeps it out of the way until you hold Shift while
| right-clicking. The same goes for the ones below.
option disabled "Off":
  $CLS\Directory\shell\TourneCmd | -
  $CLS\Directory\Background\shell\TourneCmd | -
  $CLS\Drive\shell\TourneCmd | -
option enabled "On":
  $CLS\Directory\shell\TourneCmd | MUIVerb = sz:Open command window here
  $CLS\Directory\shell\TourneCmd | Extended -
  $CLS\Directory\shell\TourneCmd | Icon = sz:cmd.exe
  $CLS\Directory\shell\TourneCmd\command | @ = sz:cmd.exe /s /k pushd "%V"
  $CLS\Directory\Background\shell\TourneCmd | MUIVerb = sz:Open command window here
  $CLS\Directory\Background\shell\TourneCmd | Extended -
  $CLS\Directory\Background\shell\TourneCmd | Icon = sz:cmd.exe
  $CLS\Directory\Background\shell\TourneCmd\command | @ = sz:cmd.exe /s /k pushd "%V"
  $CLS\Drive\shell\TourneCmd | MUIVerb = sz:Open command window here
  $CLS\Drive\shell\TourneCmd | Extended -
  $CLS\Drive\shell\TourneCmd | Icon = sz:cmd.exe
  $CLS\Drive\shell\TourneCmd\command | @ = sz:cmd.exe /s /k pushd "%V"
option shift "On, with Shift held":
  $CLS\Directory\shell\TourneCmd | MUIVerb = sz:Open command window here
  $CLS\Directory\shell\TourneCmd | Extended = sz:
  $CLS\Directory\shell\TourneCmd | Icon = sz:cmd.exe
  $CLS\Directory\shell\TourneCmd\command | @ = sz:cmd.exe /s /k pushd "%V"
  $CLS\Directory\Background\shell\TourneCmd | MUIVerb = sz:Open command window here
  $CLS\Directory\Background\shell\TourneCmd | Extended = sz:
  $CLS\Directory\Background\shell\TourneCmd | Icon = sz:cmd.exe
  $CLS\Directory\Background\shell\TourneCmd\command | @ = sz:cmd.exe /s /k pushd "%V"
  $CLS\Drive\shell\TourneCmd | MUIVerb = sz:Open command window here
  $CLS\Drive\shell\TourneCmd | Extended = sz:
  $CLS\Drive\shell\TourneCmd | Icon = sz:cmd.exe
  $CLS\Drive\shell\TourneCmd\command | @ = sz:cmd.exe /s /k pushd "%V"
detect-choice: $CLS\Directory\shell\TourneCmd | Extended
  exists = shift
  key = enabled
default: disabled

choice cmdHereAdmin "Folders: Command prompt here as administrator"
option disabled "Off":
  $CLS\Directory\shell\TourneCmdAdmin | -
  $CLS\Directory\Background\shell\TourneCmdAdmin | -
  $CLS\Drive\shell\TourneCmdAdmin | -
option enabled "On":
  $CLS\Directory\shell\TourneCmdAdmin | MUIVerb = sz:Command prompt here (administrator)
  $CLS\Directory\shell\TourneCmdAdmin | Extended -
  $CLS\Directory\shell\TourneCmdAdmin | HasLUAShield = sz:
  $CLS\Directory\shell\TourneCmdAdmin\command | @ = sz:$PS "Start-Process cmd.exe -Verb RunAs -ArgumentList '/s','/k','pushd','\"%V\"'"
  $CLS\Directory\Background\shell\TourneCmdAdmin | MUIVerb = sz:Command prompt here (administrator)
  $CLS\Directory\Background\shell\TourneCmdAdmin | Extended -
  $CLS\Directory\Background\shell\TourneCmdAdmin | HasLUAShield = sz:
  $CLS\Directory\Background\shell\TourneCmdAdmin\command | @ = sz:$PS "Start-Process cmd.exe -Verb RunAs -ArgumentList '/s','/k','pushd','\"%V\"'"
  $CLS\Drive\shell\TourneCmdAdmin | MUIVerb = sz:Command prompt here (administrator)
  $CLS\Drive\shell\TourneCmdAdmin | Extended -
  $CLS\Drive\shell\TourneCmdAdmin | HasLUAShield = sz:
  $CLS\Drive\shell\TourneCmdAdmin\command | @ = sz:$PS "Start-Process cmd.exe -Verb RunAs -ArgumentList '/s','/k','pushd','\"%V\"'"
option shift "On, with Shift held":
  $CLS\Directory\shell\TourneCmdAdmin | MUIVerb = sz:Command prompt here (administrator)
  $CLS\Directory\shell\TourneCmdAdmin | Extended = sz:
  $CLS\Directory\shell\TourneCmdAdmin | HasLUAShield = sz:
  $CLS\Directory\shell\TourneCmdAdmin\command | @ = sz:$PS "Start-Process cmd.exe -Verb RunAs -ArgumentList '/s','/k','pushd','\"%V\"'"
  $CLS\Directory\Background\shell\TourneCmdAdmin | MUIVerb = sz:Command prompt here (administrator)
  $CLS\Directory\Background\shell\TourneCmdAdmin | Extended = sz:
  $CLS\Directory\Background\shell\TourneCmdAdmin | HasLUAShield = sz:
  $CLS\Directory\Background\shell\TourneCmdAdmin\command | @ = sz:$PS "Start-Process cmd.exe -Verb RunAs -ArgumentList '/s','/k','pushd','\"%V\"'"
  $CLS\Drive\shell\TourneCmdAdmin | MUIVerb = sz:Command prompt here (administrator)
  $CLS\Drive\shell\TourneCmdAdmin | Extended = sz:
  $CLS\Drive\shell\TourneCmdAdmin | HasLUAShield = sz:
  $CLS\Drive\shell\TourneCmdAdmin\command | @ = sz:$PS "Start-Process cmd.exe -Verb RunAs -ArgumentList '/s','/k','pushd','\"%V\"'"
detect-choice: $CLS\Directory\shell\TourneCmdAdmin | Extended
  exists = shift
  key = enabled
default: disabled

choice psHereAdmin "Folders: PowerShell here as administrator"
option disabled "Off":
  $CLS\Directory\shell\TournePsAdmin | -
  $CLS\Directory\Background\shell\TournePsAdmin | -
  $CLS\Drive\shell\TournePsAdmin | -
option enabled "On":
  $CLS\Directory\shell\TournePsAdmin | MUIVerb = sz:PowerShell here (administrator)
  $CLS\Directory\shell\TournePsAdmin | Extended -
  $CLS\Directory\shell\TournePsAdmin | HasLUAShield = sz:
  $CLS\Directory\shell\TournePsAdmin\command | @ = sz:$PS "Start-Process powershell.exe -Verb RunAs -ArgumentList '-NoExit','-Command','Set-Location -LiteralPath ''%V'''"
  $CLS\Directory\Background\shell\TournePsAdmin | MUIVerb = sz:PowerShell here (administrator)
  $CLS\Directory\Background\shell\TournePsAdmin | Extended -
  $CLS\Directory\Background\shell\TournePsAdmin | HasLUAShield = sz:
  $CLS\Directory\Background\shell\TournePsAdmin\command | @ = sz:$PS "Start-Process powershell.exe -Verb RunAs -ArgumentList '-NoExit','-Command','Set-Location -LiteralPath ''%V'''"
  $CLS\Drive\shell\TournePsAdmin | MUIVerb = sz:PowerShell here (administrator)
  $CLS\Drive\shell\TournePsAdmin | Extended -
  $CLS\Drive\shell\TournePsAdmin | HasLUAShield = sz:
  $CLS\Drive\shell\TournePsAdmin\command | @ = sz:$PS "Start-Process powershell.exe -Verb RunAs -ArgumentList '-NoExit','-Command','Set-Location -LiteralPath ''%V'''"
option shift "On, with Shift held":
  $CLS\Directory\shell\TournePsAdmin | MUIVerb = sz:PowerShell here (administrator)
  $CLS\Directory\shell\TournePsAdmin | Extended = sz:
  $CLS\Directory\shell\TournePsAdmin | HasLUAShield = sz:
  $CLS\Directory\shell\TournePsAdmin\command | @ = sz:$PS "Start-Process powershell.exe -Verb RunAs -ArgumentList '-NoExit','-Command','Set-Location -LiteralPath ''%V'''"
  $CLS\Directory\Background\shell\TournePsAdmin | MUIVerb = sz:PowerShell here (administrator)
  $CLS\Directory\Background\shell\TournePsAdmin | Extended = sz:
  $CLS\Directory\Background\shell\TournePsAdmin | HasLUAShield = sz:
  $CLS\Directory\Background\shell\TournePsAdmin\command | @ = sz:$PS "Start-Process powershell.exe -Verb RunAs -ArgumentList '-NoExit','-Command','Set-Location -LiteralPath ''%V'''"
  $CLS\Drive\shell\TournePsAdmin | MUIVerb = sz:PowerShell here (administrator)
  $CLS\Drive\shell\TournePsAdmin | Extended = sz:
  $CLS\Drive\shell\TournePsAdmin | HasLUAShield = sz:
  $CLS\Drive\shell\TournePsAdmin\command | @ = sz:$PS "Start-Process powershell.exe -Verb RunAs -ArgumentList '-NoExit','-Command','Set-Location -LiteralPath ''%V'''"
detect-choice: $CLS\Directory\shell\TournePsAdmin | Extended
  exists = shift
  key = enabled
default: disabled

choice terminalMenu "Folders: Windows Terminal"
| Opens Windows Terminal in the folder, with a choice of profile.
option disabled "Off":
  $CLS\Directory\shell\TourneTerminal | -
  $CLS\Directory\Background\shell\TourneTerminal | -
option enabled "On":
  $CLS\Directory\shell\TourneTerminal | -
  $CLS\Directory\Background\shell\TourneTerminal | -
  terminal Directory {}
  terminal Directory\Background {}
option shift "On, with Shift held":
  $CLS\Directory\shell\TourneTerminal | -
  $CLS\Directory\Background\shell\TourneTerminal | -
  terminal Directory {}
  terminal Directory\Background {}
detect-choice: $CLS\Directory\shell\TourneTerminal | Extended
  exists = shift
  key = enabled
default: disabled

choice terminalAdminMenu "Folders: Windows Terminal as administrator"
option disabled "Off":
  $CLS\Directory\shell\TourneTerminalAdmin | -
  $CLS\Directory\Background\shell\TourneTerminalAdmin | -
option enabled "On":
