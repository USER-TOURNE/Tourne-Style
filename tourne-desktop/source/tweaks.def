  $CLS\Directory\shell\TourneTerminalAdmin\command | @ = sz:$PS "Start-Process wt.exe -Verb RunAs -ArgumentList '-d','\"%V\"'"
  $CLS\Directory\Background\shell\TourneTerminalAdmin | MUIVerb = sz:Terminal here (administrator)
