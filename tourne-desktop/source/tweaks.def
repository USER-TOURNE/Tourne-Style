  $DB\TourneSafeMode\shell\1min\command | @ = sz:$PS "Start-Process cmd.exe -Verb RunAs -ArgumentList '/c','bcdedit /set {current} safeboot minimal && shutdown /r /t 0'"
  $DB\TourneSafeMode\shell\2net | MUIVerb = sz:Restart in Safe Mode with networking
  $DB\TourneSafeMode\shell\2net\command | @ = sz:$PS "Start-Process cmd.exe -Verb RunAs -ArgumentList '/c','bcdedit /set {current} safeboot network && shutdown /r /t 0'"
