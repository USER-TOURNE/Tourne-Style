toggle noOnlineTips "No online tips and videos in Settings"
| Settings stops showing tips and videos it fetches from the internet.
on:
  $LMPEXP | AllowOnlineTips = dword:0
off:
  $LMPEXP | AllowOnlineTips -

text settingsPages "Settings pages to hide or show"
| "hide:" or "showonly:" followed by page names separated by ";", e.g.
| hide:home;gaming-gamebar. Page names are the ms-settings: links without
| the prefix. Empty: every page shows.
set:
  $LMPEXP | SettingsPageVisibility = sz:{}
unset:
  $LMPEXP | SettingsPageVisibility -
read: $LMPEXP | SettingsPageVisibility

toggle hideInsider "Hide the Windows Insider page"
on:
  HKLM\SOFTWARE\Microsoft\WindowsSelfHost\UI\Visibility | HideInsiderPage = dword:1
off:
  HKLM\SOFTWARE\Microsoft\WindowsSelfHost\UI\Visibility | HideInsiderPage -

############################################################# microsoft edge
group edge "Microsoft Edge"
| Policies for Edge, which it shows as "managed by your organization".
| Edge's own settings page has the sidebar, shopping, Microsoft Rewards,
| sync, SmartScreen, startup boost and the new tab page. Edge picks these up
| at its next start.

toggle firstRun "No first run experience"
on:
  $EDGE | HideFirstRunExperience = dword:1
off:
  $EDGE | HideFirstRunExperience -

toggle autoImport "No import from other browsers on first run"
on:
  $EDGE | AutoImportAtFirstRun = dword:4
off:
  $EDGE | AutoImportAtFirstRun -

toggle defaultPrompts "No \"make Edge your default browser\" prompts"
on:
  $EDGE | DefaultBrowserSettingsCampaignEnabled = dword:0
  $EDGE | ShowPDFDefaultRecommendationsEnabled = dword:0
off:
  $EDGE | DefaultBrowserSettingsCampaignEnabled -
  $EDGE | ShowPDFDefaultRecommendationsEnabled -
detect:
  $EDGE | DefaultBrowserSettingsCampaignEnabled = dword:0

toggle implicitSignIn "No automatic sign-in with the Windows account"
on:
  $EDGE | ImplicitSignInEnabled = dword:0
off:
  $EDGE | ImplicitSignInEnabled -

toggle personalization "No personalisation of ads, news and the browser"
on:
  $EDGE | PersonalizationReportingEnabled = dword:0
off:
  $EDGE | PersonalizationReportingEnabled -

toggle recommendations "No recommendations and desktop notifications"
on:
  $EDGE | ShowRecommendationsEnabled = dword:0
off:
  $EDGE | ShowRecommendationsEnabled -

toggle follow "No Follow creators"
on:
  $EDGE | EdgeFollowEnabled = dword:0
off:
  $EDGE | EdgeFollowEnabled -

toggle standaloneSidebar "No standalone sidebar"
| The Copilot sidebar Edge can pin to the side of the screen, outside the
| browser.
on:
  $EDGE | StandaloneHubsSidebarEnabled = dword:0
off:
  $EDGE | StandaloneHubsSidebarEnabled -

toggle collections "No Collections"
on:
  $EDGE | EdgeCollectionsEnabled = dword:0
off:
  $EDGE | EdgeCollectionsEnabled -

toggle splitScreen "No split screen"
on:
  $EDGE | SplitScreenEnabled = dword:0
off:
  $EDGE | SplitScreenEnabled -

toggle feedback "No feedback prompts"
on:
  $EDGE | UserFeedbackAllowed = dword:0
off:
  $EDGE | UserFeedbackAllowed -

toggle searchBar "No floating Bing search bar"
on:
  $EDGE | SearchbarAllowed = dword:0
off:
  $EDGE | SearchbarAllowed -

toggle restoreDialog "No \"Restore pages\" prompt after a crash"
on:
  $EDGE | HideRestoreDialogEnabled = dword:1
off:
  $EDGE | HideRestoreDialogEnabled -

toggle ntpTopSites "New tab: hide Microsoft's pinned sites"
on:
  $EDGE | NewTabPageHideDefaultTopSites = dword:1
off:
  $EDGE | NewTabPageHideDefaultTopSites -

toggle desktopShortcut "No desktop shortcut after Edge updates"
on:
  HKLM\SOFTWARE\Policies\Microsoft\EdgeUpdate | CreateDesktopShortcutDefault = dword:0
off:
  HKLM\SOFTWARE\Policies\Microsoft\EdgeUpdate | CreateDesktopShortcutDefault -

toggle noUpdates "No Edge updates"
| Edge stops updating itself. Security fixes stop too.
on:
  HKLM\SOFTWARE\Policies\Microsoft\EdgeUpdate | UpdateDefault = dword:0
  HKLM\SOFTWARE\Policies\Microsoft\EdgeUpdate | AutoUpdateCheckPeriodMinutes = dword:0
off:
  HKLM\SOFTWARE\Policies\Microsoft\EdgeUpdate | UpdateDefault -
  HKLM\SOFTWARE\Policies\Microsoft\EdgeUpdate | AutoUpdateCheckPeriodMinutes -
detect:
  HKLM\SOFTWARE\Policies\Microsoft\EdgeUpdate | UpdateDefault = dword:0

############################################################## about this pc
group system "About this PC"
| What Settings > System > About and winver show. Empty leaves each one as
| it is.

text oemManufacturer "Manufacturer"
set:
  HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\OEMInformation | Manufacturer = sz:{}
unset:
  HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\OEMInformation | Manufacturer -
read: HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\OEMInformation | Manufacturer

text oemModel "Model"
set:
  HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\OEMInformation | Model = sz:{}
unset:
  HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\OEMInformation | Model -
read: HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\OEMInformation | Model

text oemSupportHours "Support hours"
set:
  HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\OEMInformation | SupportHours = sz:{}
unset:
  HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\OEMInformation | SupportHours -
read: HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\OEMInformation | SupportHours

text oemSupportPhone "Support phone"
set:
  HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\OEMInformation | SupportPhone = sz:{}
unset:
  HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\OEMInformation | SupportPhone -
read: HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\OEMInformation | SupportPhone

text oemSupportUrl "Support website"
set:
  HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\OEMInformation | SupportURL = sz:{}
unset:
  HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\OEMInformation | SupportURL -
read: HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\OEMInformation | SupportURL

text oemLogo "Logo (.bmp, 120 x 120)" format=filePath
set:
  HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\OEMInformation | Logo = sz:{}
unset:
  HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\OEMInformation | Logo -
read: HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\OEMInformation | Logo

text registeredOwner "Registered owner" keep-empty private
| Shown in winver. Empty: left as it is.
set:
  HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion | RegisteredOwner = sz:{}

text registeredOrganization "Registered organisation" keep-empty private
| Empty: left as it is.
set:
  HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion | RegisteredOrganization = sz:{}
