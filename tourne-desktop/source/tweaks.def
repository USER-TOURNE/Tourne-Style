  $DB\TourneSafeMode | -

toggle advancedStartup "Advanced startup"
| Restarts into the recovery options: Safe Mode, firmware settings, repair.
on:
  $DB\TourneAdvancedStartup | MUIVerb = sz:Advanced startup
  $DB\TourneAdvancedStartup | Icon = sz:bootux.dll,-1032
  $DB\TourneAdvancedStartup | Position = sz:Bottom
  $DB\TourneAdvancedStartup\command | @ = sz:shutdown.exe /r /o /f /t 0
off:
  $DB\TourneAdvancedStartup | -

toggle firmwareMenu "Restart to firmware (UEFI)"
| Restarts straight into the PC's firmware settings.
on:
  $DB\TourneFirmware | MUIVerb = sz:Restart to firmware settings
  $DB\TourneFirmware | HasLUAShield = sz:
  $DB\TourneFirmware | Position = sz:Bottom
  $DB\TourneFirmware\command | @ = sz:$PS "Start-Process shutdown.exe -Verb RunAs -ArgumentList '/r','/fw','/t','0'"
off:
  $DB\TourneFirmware | -

toggle restorePointMenu "Create restore point"
on:
  $DB\TourneRestorePoint | MUIVerb = sz:Create restore point
  $DB\TourneRestorePoint | Icon = sz:rstrui.exe
  $DB\TourneRestorePoint | HasLUAShield = sz:
  $DB\TourneRestorePoint\command | @ = sz:$PS "Start-Process powershell.exe -Verb RunAs -ArgumentList '-NoProfile','-Command','Checkpoint-Computer -Description (Get-Date -Format g) -RestorePointType MODIFY_SETTINGS; pause'"
off:
  $DB\TourneRestorePoint | -

toggle sfcMenu "Check system files (sfc)"
| Runs sfc /scannow, which repairs damaged Windows files.
on:
  $DB\TourneSfc | MUIVerb = sz:Check system files
  $DB\TourneSfc | HasLUAShield = sz:
  $DB\TourneSfc\command | @ = sz:$PS "Start-Process cmd.exe -Verb RunAs -ArgumentList '/k','sfc /scannow'"
off:
  $DB\TourneSfc | -

toggle repairImage "Repair Windows image"
| Runs DISM to check or repair the Windows image that sfc repairs from.
on:
  $DB\TourneDism | MUIVerb = sz:Repair Windows image
  $DB\TourneDism | SubCommands = sz:
  $DB\TourneDism | HasLUAShield = sz:
  $DB\TourneDism\shell\1check | MUIVerb = sz:Check health
  $DB\TourneDism\shell\1check\command | @ = sz:$PS "Start-Process cmd.exe -Verb RunAs -ArgumentList '/k','DISM /Online /Cleanup-Image /CheckHealth'"
  $DB\TourneDism\shell\2scan | MUIVerb = sz:Scan health
  $DB\TourneDism\shell\2scan\command | @ = sz:$PS "Start-Process cmd.exe -Verb RunAs -ArgumentList '/k','DISM /Online /Cleanup-Image /ScanHealth'"
  $DB\TourneDism\shell\3repair | MUIVerb = sz:Repair
  $DB\TourneDism\shell\3repair\command | @ = sz:$PS "Start-Process cmd.exe -Verb RunAs -ArgumentList '/k','DISM /Online /Cleanup-Image /RestoreHealth'"
off:
  $DB\TourneDism | -

toggle compactOs "Compact OS"
| Compresses or decompresses Windows' own files to save space.
on:
  $DB\TourneCompactOs | MUIVerb = sz:Compact OS
  $DB\TourneCompactOs | SubCommands = sz:
  $DB\TourneCompactOs | HasLUAShield = sz:
  $DB\TourneCompactOs\shell\1query | MUIVerb = sz:Show state
  $DB\TourneCompactOs\shell\1query\command | @ = sz:$PS "Start-Process cmd.exe -Verb RunAs -ArgumentList '/k','compact /compactos:query'"
  $DB\TourneCompactOs\shell\2on | MUIVerb = sz:Compress Windows
  $DB\TourneCompactOs\shell\2on\command | @ = sz:$PS "Start-Process cmd.exe -Verb RunAs -ArgumentList '/k','compact /compactos:always'"
  $DB\TourneCompactOs\shell\3off | MUIVerb = sz:Decompress Windows
  $DB\TourneCompactOs\shell\3off\command | @ = sz:$PS "Start-Process cmd.exe -Verb RunAs -ArgumentList '/k','compact /compactos:never'"
off:
  $DB\TourneCompactOs | -

###################################################### right-click menu: new
group menuNew "Right-click menu: New"
| File types added to New in right-click menus.

toggle newBat "Batch file (.bat)"
on:
  $CLS\.bat\ShellNew | NullFile = sz:
off:
  $CLS\.bat\ShellNew | -

toggle newCmd "Command script (.cmd)"
on:
  $CLS\.cmd\ShellNew | NullFile = sz:
off:
  $CLS\.cmd\ShellNew | -

toggle newPs1 "PowerShell script (.ps1)"
on:
  $CLS\.ps1\ShellNew | NullFile = sz:
off:
  $CLS\.ps1\ShellNew | -

toggle newVbs "VBScript file (.vbs)"
on:
  $CLS\.vbs\ShellNew | NullFile = sz:
off:
  $CLS\.vbs\ShellNew | -

toggle newReg "Registration entries (.reg)"
on:
  $CLS\.reg\ShellNew | NullFile = sz:
off:
  $CLS\.reg\ShellNew | -

#################################################### lock screen and sign-in
group signin "Lock screen and sign-in"
| The lock screen picture and its fun facts are in Settings >
| Personalization > Lock screen; sign-in options are in Settings > Accounts.

toggle noLockScreen "Skip the lock screen"
| Waking or starting the PC goes straight to the sign-in screen.
on:
  $WPOL\Personalization | NoLockScreen = dword:1
off:
  $WPOL\Personalization | NoLockScreen -

text lockScreenImage "Lock screen picture for everyone" after=signout format=filePath
| A picture shown on the lock and sign-in screens for every account. While
| it's set, Settings can't change the lock screen picture. Empty: off.
set:
  $WPOL\Personalization | LockScreenImage = sz:{}
unset:
  $WPOL\Personalization | LockScreenImage -
read: $WPOL\Personalization | LockScreenImage

number slideshowDuration "Lock screen slideshow length (s)" default=0 min=0 max=86400
| How long a lock screen slideshow plays before the screen turns off. 0: the
| Windows default.
set:
  HKCU\Software\Microsoft\Windows\CurrentVersion\Lock Screen | SlideshowDuration = dword:{ms}
unset:
  HKCU\Software\Microsoft\Windows\CurrentVersion\Lock Screen | SlideshowDuration -
read: HKCU\Software\Microsoft\Windows\CurrentVersion\Lock Screen | SlideshowDuration as=ms

toggle hideLockedUser "Hide your name on the lock screen"
on:
  $PSYS | DontDisplayLockedUserId = dword:3
off:
  $PSYS | DontDisplayLockedUserId -

toggle noLockNetworkIcon "No network icon on the lock screen"
on:
  $WPOL\System | DontDisplayNetworkSelectionUI = dword:1
off:
  $WPOL\System | DontDisplayNetworkSelectionUI -

toggle noLogonBlur "Sign-in screen: sharp background"
| The lock screen picture stays sharp behind the sign-in box instead of
| blurred.
on:
  $WPOL\System | DisableAcrylicBackgroundOnLogon = dword:1
off:
  $WPOL\System | DisableAcrylicBackgroundOnLogon -

toggle noLogonImage "Sign-in screen: plain colour background"
| The accent colour instead of the lock screen picture. Wins over the one
| above.
on:
  $WPOL\System | DisableLogonBackgroundImage = dword:1
off:
  $WPOL\System | DisableLogonBackgroundImage = dword:0

toggle hideLastUser "Sign-in screen: don't show the last user"
| Everyone types their user name.
on:
  $PSYS | dontdisplaylastusername = dword:1
off:
  $PSYS | dontdisplaylastusername = dword:0

toggle noLogonPowerButton "Sign-in screen: no power button"
on:
  $PSYS | shutdownwithoutlogon = dword:0
off:
  $PSYS | shutdownwithoutlogon = dword:1

toggle numLockAtLogon "Sign-in screen: Num Lock on"
on:
  HKU\.DEFAULT\Control Panel\Keyboard | InitialKeyboardIndicators = sz:2
off:
  HKU\.DEFAULT\Control Panel\Keyboard | InitialKeyboardIndicators = sz:2147483648

toggle requireCtrlAltDel "Press Ctrl + Alt + Del to sign in"
on:
  HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon | DisableCAD = dword:0
off:
  HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon | DisableCAD = dword:1

toggle autoLogonCheckbox "Bring back automatic sign-in in netplwiz"
| Shows the "Users must enter a user name and password" box in netplwiz
| again, which is how you set up signing in without a password.
on:
  HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\PasswordLess\Device | DevicePasswordLessBuildVersion = dword:0
off:
  HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\PasswordLess\Device | DevicePasswordLessBuildVersion = dword:2

text signInTitle "Message before sign-in: title"
| Shown to everyone before they sign in. Empty: no message.
set:
  $PSYS | legalnoticecaption = sz:{}
unset:
  $PSYS | legalnoticecaption = sz:
read: $PSYS | legalnoticecaption

text signInText "Message before sign-in: text"
set:
  $PSYS | legalnoticetext = sz:{}
unset:
  $PSYS | legalnoticetext = sz:
read: $PSYS | legalnoticetext

toggle verboseStatus "Detailed status messages"
| Signing in and shutting down show what Windows is doing ("Applying user
| settings...") instead of "Please wait".
on:
  $PSYS | VerboseStatus = dword:1
off:
  $PSYS | VerboseStatus -

toggle noPasswordReveal "No password reveal button"
| Removes the eye button that shows a password as you type it.
on:
  $WPOL\CredUI | DisablePasswordReveal = dword:1
off:
  $WPOL\CredUI | DisablePasswordReveal -

############################################## startup, recovery and crashes
group boot "Startup, recovery and crashes"

toggle autoRepair "Automatic repair after failed starts" default=true after=restart
| After two failed starts Windows tries to repair itself. The build can't
| read this without admin, so it starts on, the Windows default.
on:
  admin bcdedit /set {current} recoveryenabled Yes
off:
  admin bcdedit /set {current} recoveryenabled No

toggle legacyBootMenu "F8 boot menu" default=false after=restart
| The Windows 7 style menu: press F8 while the PC starts for Safe Mode and
| the other startup options. Starts off, the Windows default.
on:
  admin bcdedit /set {current} bootmenupolicy Legacy
off:
  admin bcdedit /set {current} bootmenupolicy Standard

toggle bootLogo "Boot logo and spinner" default=true after=restart
on:
  admin bcdedit /deletevalue {current} quietboot
off:
  admin bcdedit /set {current} quietboot Yes

number chkdskTimeout "Disk check countdown at startup (s)" default=8 min=0 max=259200
| How long you have to skip a scheduled disk check.
set:
  HKLM\SYSTEM\CurrentControlSet\Control\Session Manager | AutoChkTimeout = dword:{}
read: HKLM\SYSTEM\CurrentControlSet\Control\Session Manager | AutoChkTimeout

toggle bsodNoSmiley "Stop screen without the sad face" after=restart
on:
  HKLM\SYSTEM\CurrentControlSet\Control\CrashControl | DisableEmoticon = dword:1
off:
  HKLM\SYSTEM\CurrentControlSet\Control\CrashControl | DisableEmoticon -

toggle bsodDetails "Stop screen shows technical details" after=restart
| The blue screen lists the error's parameters, for tracking down a crash.
on:
  HKLM\SYSTEM\CurrentControlSet\Control\CrashControl | DisplayParameters = dword:1
off:
  HKLM\SYSTEM\CurrentControlSet\Control\CrashControl | DisplayParameters -

toggle crashOnScroll "Crash on purpose with Ctrl + Scroll Lock" after=restart
| For debugging: hold right Ctrl and press Scroll Lock twice to blue screen
| and write a crash dump.
on:
  HKLM\SYSTEM\CurrentControlSet\Services\kbdhid\Parameters | CrashOnCtrlScroll = dword:1
  HKLM\SYSTEM\CurrentControlSet\Services\i8042prt\Parameters | CrashOnCtrlScroll = dword:1
off:
  HKLM\SYSTEM\CurrentControlSet\Services\kbdhid\Parameters | CrashOnCtrlScroll -
  HKLM\SYSTEM\CurrentControlSet\Services\i8042prt\Parameters | CrashOnCtrlScroll -
detect:
  HKLM\SYSTEM\CurrentControlSet\Services\kbdhid\Parameters | CrashOnCtrlScroll = dword:1

toggle registryBackup "Automatic registry backup" after=restart
| Windows stopped backing up the registry in 2018; this turns it back on (to
| C:\Windows\System32\config\RegBack).
on:
  HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Configuration Manager | EnablePeriodicBackup = dword:1
off:
  HKLM\SYSTEM\CurrentControlSet\Control\Session Manager\Configuration Manager | EnablePeriodicBackup -

toggle restorePointAnyTime "Create restore points without the 24-hour limit"
| Windows skips a new restore point when one was made in the last 24 hours.
on:
  HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\SystemRestore | SystemRestorePointCreationFrequency = dword:0
off:
  HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\SystemRestore | SystemRestorePointCreationFrequency -

#################################################### updates and maintenance
group updates "Updates and maintenance"
| Pausing updates is in Settings > Windows Update.

toggle noWindowsUpdate "No automatic Windows updates"
| Stops automatic downloads, installs and restarts. You can still check for
| updates by hand in Settings.
on:
  $WPOL\WindowsUpdate\AU | NoAutoUpdate = dword:1
  $WPOL\WindowsUpdate\AU | AUOptions = dword:1
  $WPOL\WindowsUpdate\AU | NoAutoRebootWithLoggedOnUsers = dword:1
off:
  $WPOL\WindowsUpdate\AU | NoAutoUpdate -
  $WPOL\WindowsUpdate\AU | AUOptions -
  $WPOL\WindowsUpdate\AU | NoAutoRebootWithLoggedOnUsers -
detect:
  $WPOL\WindowsUpdate\AU | NoAutoUpdate = dword:1

toggle noDriverUpdates "No driver updates from Windows Update"
| Windows Update stops replacing drivers, such as the graphics driver you
| installed yourself.
on:
  $WPOL\WindowsUpdate | ExcludeWUDriversInQualityUpdate = dword:1
  HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\DriverSearching | SearchOrderConfig = dword:0
off:
  $WPOL\WindowsUpdate | ExcludeWUDriversInQualityUpdate -
  HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\DriverSearching | SearchOrderConfig = dword:1
detect:
  $WPOL\WindowsUpdate | ExcludeWUDriversInQualityUpdate = dword:1

toggle noMrt "Don't install the Malicious Software Removal Tool"
| Windows Update stops installing and running the monthly Malicious Software
| Removal Tool.
on:
  HKLM\SOFTWARE\Policies\Microsoft\MRT | DontOfferThroughWUAU = dword:1
off:
  HKLM\SOFTWARE\Policies\Microsoft\MRT | DontOfferThroughWUAU -

toggle noMaintenance "Turn off automatic maintenance"
| Stops the cleanup, scans and updates Windows runs while the PC is idle.
on:
  HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Schedule\Maintenance | MaintenanceDisabled = dword:1
off:
  HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Schedule\Maintenance | MaintenanceDisabled -

############################################# security, accounts and network
group security "Security, accounts and network"
| Windows Security has SmartScreen and blocking potentially unwanted apps.
| Turning any of these off makes the PC less safe.

choice uac "User Account Control" after=restart
| Off lets every program run with full rights, silently. The slider in
| Control Panel can't turn it fully off; this can.
option enabled "On (Windows default)":
  $PSYS | EnableLUA = dword:1
option disabled "Off":
  $PSYS | EnableLUA = dword:0
detect-choice: $PSYS | EnableLUA
  1 = enabled
  0 = disabled
default: enabled

toggle adminApproval "UAC for the built-in Administrator" after=restart
| Whether the built-in Administrator account also gets UAC prompts.
on:
  $PSYS | FilterAdministratorToken = dword:1
off:
  $PSYS | FilterAdministratorToken = dword:0

toggle builtinAdmin "Built-in Administrator account"
| Turns on the hidden account named Administrator.
on:
  admin net user Administrator /active:yes
off:
  admin net user Administrator /active:no
detect:
  localuser Administrator

toggle noDefender "Turn off Microsoft Defender Antivirus" after=restart
| Only works with Tamper Protection off (Windows Security > Virus & threat
| protection > Manage settings).
on:
  HKLM\SOFTWARE\Policies\Microsoft\Windows Defender | DisableAntiSpyware = dword:1
off:
  HKLM\SOFTWARE\Policies\Microsoft\Windows Defender | DisableAntiSpyware -

toggle noDownloadBlocking "Don't mark downloaded files"
| New downloads skip the "this file came from another computer" warning.
on:
  HKCU\Software\Microsoft\Windows\CurrentVersion\Policies\Attachments | SaveZoneInformation = dword:1
off:
  HKCU\Software\Microsoft\Windows\CurrentVersion\Policies\Attachments | SaveZoneInformation -

toggle usbWriteProtect "Write-protect USB drives" after=restart
| Nothing can be written to USB drives, only read.
on:
  HKLM\SYSTEM\CurrentControlSet\Control\StorageDevicePolicies | WriteProtect = dword:1
off:
  HKLM\SYSTEM\CurrentControlSet\Control\StorageDevicePolicies | WriteProtect -

toggle msiSafeMode "Windows Installer works in Safe Mode"
| Lets you uninstall programs while in Safe Mode.
on:
  HKLM\SYSTEM\CurrentControlSet\Control\SafeBoot\Minimal\MSIServer | @ = sz:Service
  HKLM\SYSTEM\CurrentControlSet\Control\SafeBoot\Network\MSIServer | @ = sz:Service
off:
  HKLM\SYSTEM\CurrentControlSet\Control\SafeBoot\Minimal\MSIServer | -
  HKLM\SYSTEM\CurrentControlSet\Control\SafeBoot\Network\MSIServer | -
detect:
  HKLM\SYSTEM\CurrentControlSet\Control\SafeBoot\Minimal\MSIServer | @ = sz:Service

toggle adminShares "Administrative shares (C$, ADMIN$)" after=restart
| The hidden C$ and ADMIN$ shares remote administration tools use.
on:
  HKLM\SYSTEM\CurrentControlSet\Services\LanmanServer\Parameters | AutoShareWks -
off:
  HKLM\SYSTEM\CurrentControlSet\Services\LanmanServer\Parameters | AutoShareWks = dword:0
detect:
  HKLM\SYSTEM\CurrentControlSet\Services\LanmanServer\Parameters | AutoShareWks -

toggle linkedConnections "Mapped drives in programs run as administrator" after=restart
| Mapped network drives also show in programs run as administrator.
on:
  $PSYS | EnableLinkedConnections = dword:1
off:
  $PSYS | EnableLinkedConnections -

number rdpPort "Remote Desktop port" default=3389 min=1 max=65535 after=restart
| Open the new port in the firewall too.
set:
  HKLM\SYSTEM\CurrentControlSet\Control\Terminal Server\WinStations\RDP-Tcp | PortNumber = dword:{}
read: HKLM\SYSTEM\CurrentControlSet\Control\Terminal Server\WinStations\RDP-Tcp | PortNumber

toggle ipRouting "IP routing (forwarding)" after=restart
| Lets this PC pass network traffic between its connections, like a router.
on:
  HKLM\SYSTEM\CurrentControlSet\Services\Tcpip\Parameters | IPEnableRouter = dword:1
off:
  HKLM\SYSTEM\CurrentControlSet\Services\Tcpip\Parameters | IPEnableRouter = dword:0

###################################################### power and performance
group power "Power and performance"

choice hibernation "Hibernation"
option disabled "Off (also turns off fast startup)":
  admin powercfg.exe /hibernate off
option enabled "On":
  admin powercfg.exe /hibernate on
  admin powercfg.exe /hibernate /type full
option reduced "Fast startup only (small file)":
  admin powercfg.exe /hibernate on
  admin powercfg.exe /hibernate /type reduced
detect-choice: HKLM\SYSTEM\CurrentControlSet\Control\Power | HibernateEnabled
  0 = disabled
  1 = enabled
default: enabled

number hiberFileSize "Hibernation file size (% of RAM)" default=0 min=0 max=100 zero-off
| 0: leave it as it is (with hibernation off there's no file). 40 to 100:
| the file's size as a share of RAM, used when hibernation is on.
set:
  admin powercfg.exe /hibernate /size {}
read: HKLM\SYSTEM\CurrentControlSet\Control\Power | HiberFileSizePercent

toggle noPowerThrottling "Turn off power throttling" after=restart
| Windows slows down programs in the background to save battery; this stops
| it.
on:
  HKLM\SYSTEM\CurrentControlSet\Control\Power\PowerThrottling | PowerThrottlingOff = dword:1
off:
  HKLM\SYSTEM\CurrentControlSet\Control\Power\PowerThrottling | PowerThrottlingOff -

toggle wakePassword "Show \"Require a password on wakeup\" in Power Options"
| Windows hides this choice in a power plan's advanced settings; this shows
| it.
on:
  HKLM\SYSTEM\CurrentControlSet\Control\Power\PowerSettings\0e796bdb-100d-47d6-a2d5-f7d2daa51f51 | Attributes = dword:2
off:
  HKLM\SYSTEM\CurrentControlSet\Control\Power\PowerSettings\0e796bdb-100d-47d6-a2d5-f7d2daa51f51 | Attributes = dword:1

number screenSaverGrace "Screen saver lock grace period (s)" default=5 min=0 max=3600
| Seconds a password-protected screen saver runs before it locks.
set:
  HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon | ScreenSaverGracePeriod = sz:{}
unset:
  HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon | ScreenSaverGracePeriod -
read: HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon | ScreenSaverGracePeriod

number svchostSplitKB "Svchost split threshold (KB)" default=3670016 min=0 max=2147483647
| Above this much RAM, each service gets its own svchost.exe. Set it above
| your RAM (e.g. 33554432 for 32 GB) for fewer svchost processes.
set:
  HKLM\SYSTEM\CurrentControlSet\Control | SvcHostSplitThresholdInKB = dword:{}
read: HKLM\SYSTEM\CurrentControlSet\Control | SvcHostSplitThresholdInKB

############################################################## built-in apps
group apps "Built-in apps"
| Store app updates are in the Microsoft Store's own settings.

toggle photoViewer "Windows Photo Viewer in \"Open with\""
| Registers the old viewer for common image types; choose it once in Open
| with or Default apps.
on:
  HKLM\SOFTWARE\Microsoft\Windows Photo Viewer\Capabilities\FileAssociations | .jpg = sz:PhotoViewer.FileAssoc.Tiff
  HKLM\SOFTWARE\Microsoft\Windows Photo Viewer\Capabilities\FileAssociations | .jpeg = sz:PhotoViewer.FileAssoc.Tiff
  HKLM\SOFTWARE\Microsoft\Windows Photo Viewer\Capabilities\FileAssociations | .png = sz:PhotoViewer.FileAssoc.Tiff
  HKLM\SOFTWARE\Microsoft\Windows Photo Viewer\Capabilities\FileAssociations | .bmp = sz:PhotoViewer.FileAssoc.Tiff
  HKLM\SOFTWARE\Microsoft\Windows Photo Viewer\Capabilities\FileAssociations | .gif = sz:PhotoViewer.FileAssoc.Tiff
  HKLM\SOFTWARE\Microsoft\Windows Photo Viewer\Capabilities\FileAssociations | .ico = sz:PhotoViewer.FileAssoc.Tiff
off:
  HKLM\SOFTWARE\Microsoft\Windows Photo Viewer\Capabilities\FileAssociations | .jpg -
  HKLM\SOFTWARE\Microsoft\Windows Photo Viewer\Capabilities\FileAssociations | .jpeg -
  HKLM\SOFTWARE\Microsoft\Windows Photo Viewer\Capabilities\FileAssociations | .png -
  HKLM\SOFTWARE\Microsoft\Windows Photo Viewer\Capabilities\FileAssociations | .bmp -
  HKLM\SOFTWARE\Microsoft\Windows Photo Viewer\Capabilities\FileAssociations | .gif -
  HKLM\SOFTWARE\Microsoft\Windows Photo Viewer\Capabilities\FileAssociations | .ico -
detect:
  HKLM\SOFTWARE\Microsoft\Windows Photo Viewer\Capabilities\FileAssociations | .png = sz:PhotoViewer.FileAssoc.Tiff

toggle noInk "Turn off Windows Ink Workspace"
| Removes the Windows Ink Workspace pen menu.
on:
  HKLM\SOFTWARE\Policies\Microsoft\WindowsInkWorkspace | AllowWindowsInkWorkspace = dword:0
off:
  HKLM\SOFTWARE\Policies\Microsoft\WindowsInkWorkspace | AllowWindowsInkWorkspace -

toggle noOneDriveBackup "Don't move Desktop, Documents and Pictures to OneDrive"
| Stops OneDrive offering to move these folders into OneDrive. Folders it
| already moved stay where they are.
on:
  HKLM\SOFTWARE\Policies\Microsoft\OneDrive | KFMBlockOptIn = dword:1
off:
  HKLM\SOFTWARE\Policies\Microsoft\OneDrive | KFMBlockOptIn -

############################################# control panel and settings app
group panels "Control Panel and Settings app"
| Classic pages added back to Control Panel, and pages taken out of
| Settings.

toggle netplwiz "Control Panel: User Accounts (classic)" after=explorer
on:
  $LMCLS\CLSID\{5A1E7B1C-3E2F-4D0A-9C1B-7E0F2A6D4B01} | @ = sz:User Accounts (classic)
  $LMCLS\CLSID\{5A1E7B1C-3E2F-4D0A-9C1B-7E0F2A6D4B01} | InfoTip = sz:User Accounts (classic)
  $LMCLS\CLSID\{5A1E7B1C-3E2F-4D0A-9C1B-7E0F2A6D4B01} | System.ControlPanel.Category = sz:1
  $LMCLS\CLSID\{5A1E7B1C-3E2F-4D0A-9C1B-7E0F2A6D4B01}\DefaultIcon | @ = expand:%SystemRoot%\System32\netplwiz.exe
  $LMCLS\CLSID\{5A1E7B1C-3E2F-4D0A-9C1B-7E0F2A6D4B01}\Shell\Open\Command | @ = expand:%SystemRoot%\System32\netplwiz.exe
  $LMEXP\ControlPanel\NameSpace\{5A1E7B1C-3E2F-4D0A-9C1B-7E0F2A6D4B01} | @ = sz:User Accounts (classic)
off:
  $LMEXP\ControlPanel\NameSpace\{5A1E7B1C-3E2F-4D0A-9C1B-7E0F2A6D4B01} | -
  $LMCLS\CLSID\{5A1E7B1C-3E2F-4D0A-9C1B-7E0F2A6D4B01} | -
detect:
  $LMEXP\ControlPanel\NameSpace\{5A1E7B1C-3E2F-4D0A-9C1B-7E0F2A6D4B01} | +

toggle classicBackground "Control Panel: Desktop Background" after=explorer
on:
  $LMCLS\CLSID\{5A1E7B1C-3E2F-4D0A-9C1B-7E0F2A6D4B02} | @ = sz:Desktop Background
  $LMCLS\CLSID\{5A1E7B1C-3E2F-4D0A-9C1B-7E0F2A6D4B02} | InfoTip = sz:Desktop Background
  $LMCLS\CLSID\{5A1E7B1C-3E2F-4D0A-9C1B-7E0F2A6D4B02} | System.ControlPanel.Category = sz:1
  $LMCLS\CLSID\{5A1E7B1C-3E2F-4D0A-9C1B-7E0F2A6D4B02}\DefaultIcon | @ = expand:%SystemRoot%\System32\imageres.dll,-110
